":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, please keep in mind your overall impression of Response A & Response B...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, please keep in mind your overall impression of Response A &amp; Response B, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P04_Both","QuestionID":"QID158"}},{"SurveyID":"SV_elJCHDTDWBcCbD8","Element":"SQ","PrimaryAttribute":"QID159","SecondaryAttribute":"Which response do you prefer?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which response do you prefer?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"QuestionDescription":"Which response do you prefer?","Choices":{"1":{"Display":"Response A"},"2":{"Display":"Response B"},"3":{"Display":"No Preference"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":3,"QuestionText_Unsafe":"Which response do you prefer?","DataExportTag":"P04_V1_Preference","QuestionID":"QID159"}},{"SurveyID":"SV_elJCHDTDWBcCbD8","Element":"SQ","PrimaryAttribute":"QID16","SecondaryAttribute":"Why did you prefer one response over the other, or neither? Please explain your reasoning, includ...","TertiaryAttribute":null,"Payload":{"QuestionText":"Why did you prefer one response over the other, or neither? Please explain your reasoning, including what you liked or disliked about each response.","DefaultChoices":false,"DataExportTag":"","QuestionID":"QID16","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":fal