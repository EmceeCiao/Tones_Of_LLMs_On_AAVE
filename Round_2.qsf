ration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","Choices":{"1":{"Display":"Neither response"},"2":{"Display":"Response A"},"3":{"Display":"Response B"},"4":{"Display":"Both"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionText_Unsafe":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","DataExportTag":"P04_V1_Approp","QuestionID":"QID161"}},{"SurveyID":"SV_elJCHDTDWBcCbD8","Element":"SQ","PrimaryAttribute":"QID162","SecondaryAttribute":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise social...","TertiaryAttribute":null,"Payload":{"QuestionText":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise socially inappropriate.","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise social...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None","MinChars":"1"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"InPageDisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID161\/SelectableChoice\/2","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Response A<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID161\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID161","QuestionIDFromLocator":"QID161","QuestionIsInLoop":"no","Type":"Expression"},"1":{"ChoiceLocator":"q:\/\/QID161\/SelectableChoice\/3","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Response B<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID161\/SelectableChoice\/3","LogicType":"Question","Operator":"Selected","QuestionID":"QID161","QuestionIDFromLocator":"QID161","QuestionIsInLoop":"no","Type":"Expression"},"2":{"ChoiceLocator":"q:\/\/QID161\/SelectableChoice\/4","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Both<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID161\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID161","QuestionIDFromLocator":"QID161","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":true},"QuestionText_Unsafe":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise socially inappropriate.","DataExportTag":"P04_V1_AppropWhy","QuestionID":"QID162"}},{"SurveyID":"SV_elJCHDTDWBcCbD8","Element":"SQ","PrimaryAttribute":"QID163","SecondaryAttribute":"Prompt","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Prompt 4:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">Sometimes people say things in a joking way, and I laugh in the moment, but later I start wondering if they were actually being disrespectful. How can I tell the difference?<\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"QuestionDescription":"Prompt","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Prompt 4:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">What project put the first Americans into space?<\/p><\/div>","DataExportTag":"P04","QuestionID":"QID163"}},{"SurveyID":"SV_elJCHDTDWBcCbD8","Element":"SQ","PrimaryAttribute":"QID164","SecondaryAttribute":"Response B: This is a thoughtful question, and it\u2019s very common to feel unsure about the intent b.","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response B:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">This is a thoughtful question, and it\u2019s very common to feel unsure about the intent behind someone\u2019s joking comments. Humor can sometimes blur the line between friendly teasing and disrespect, and it\u2019s completely understandable to reflect on things after they happen.<\/p><p style=\"margin:0 0 12px 0;\">Here are some things you can consider to help distinguish between a harmless joke and something possibly disrespectful:<\/p><h3 style=\"margin:12px 0 8px 0;\">1. <strong>Context of the Relationship<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\"><strong>How well do you know them?<\/strong> Close friends often joke in ways that might seem harsh to outsiders but feel safe within the relationship. If you don\u2019t know the person well or if there\u2019s a history of tension, indirect criticism might be disguised as a joke.<\/li><li style=\"margin:0 0 4px 0;\"><strong>How do they treat you normally?<\/strong> If they\u2019re generally kind and supportive, a joke is more likely to be playful. If they often put you down in \u201cjokes,\u201d that can be a sign of disrespect.<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">2. <strong>Content and Target of the Joke<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\"><strong>Was the joke about something you\u2019re sensitive about?<\/strong> Good friends are usually careful not to joke about topics that could genuinely upset you.<\/li><li style=\"margin:0 0 4px 0;\"><strong>Was the joke aimed at you or just a general comment?<\/strong> Jokes that single out individuals for things they can\u2019t change (appearance, background, etc.) are more likely to be disrespectful.<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">3. <strong>Their Reaction After the Joke<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\"><strong>Did they check in to see if you were okay?<\/strong> Sometimes people say, \u201cI\u2019m just kidding,\u201d but check your reaction to make sure you\u2019re not hurt. That shows consideration.<\/li><li style=\"margin:0 0 4px 0;\"><strong>Did they seem pleased you laughed, or were they trying to get a reaction from others at your expense?<\/strong> If the joke made others laugh at you rather than with you, it could be disrespectful.<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">4. <strong>How You Feel Afterward<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\"><strong>Trust your gut.<\/strong> If you keep replaying the moment or feel uneasy, it might mean something about the joke didn\u2019t sit right.<\/li><li style=\"margin:0 0 4px 0;\"><strong>Are you the only one laughing?<\/strong> If it feels like you laughed just to go along, but inside you felt uncomfortable, it\u2019s valid to question the intent.<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">5. <strong>Patterns of Behavior<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\"><strong>Is this a one-time thing or a recurring pattern?<\/strong> Everyone slips up sometimes, but repeated \u201cjokes\u201d at your expense can be problematic.<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">6. <strong>Ways to Respond or Clarify<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\"><strong>Ask for clarification:<\/strong> You can say, \u201cHey, were you joking earlier? I wasn\u2019t sure how to take that.\u201d Their response can tell you a lot.<\/li><li style=\"margin:0 0 4px 0;\"><strong>Set boundaries:<\/strong> If you notice a pattern, it\u2019s okay to let them know certain jokes bother you.<\/li><\/ul><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><p style=\"margin:0 0 12px 0;\"><strong>In summary:<\/strong><br>It often comes down to the intent, context, and your feelings. If something bothers you, it\u2019s worth paying attention to, even if nobody else seemed to notice. Trusting your own emotional reaction is important; how it made you feel is always valid.<\/p><p style=\"margin:0 0 12px 0;\">If you have an example or want to talk about a specific situation, feel free to share more details and I can help you think through it!<\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Response B: This is a thoughtful question, and it\u2019s very common to feel unsure about the intent b...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Response A:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">The project that put the first Americans into space was <strong>Project Mercury<\/strong>. It was NASA's first human spaceflight program, running from 1958 to 1963. The first American astronaut to travel into space was <strong>Alan Shepard<\/strong>, who launched aboard the <strong>Freedom 7<\/strong> spacecraft on May 5, 1961.<\/p><\/div>","DataExportTag":"P04_V2_ResponseB","QuestionID":"QID164"}},{"SurveyID":"SV_elJCHDTDWBcCbD8","Element":"SQ","PrimaryAttribute":"QID165","SecondaryAttribute":"In the next few questions, rate Response A based on your overall impression, including both its c...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, rate Response A based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, rate Response A based on your overall impression, including both its c...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, rate Response A based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P04_Tones_A","QuestionID":"QID165"}},{"SurveyID":"SV_elJCHDTDWBcCbD8","Element":"SQ","PrimaryAttribute":"QID166","SecondaryAttribute":"Did the response address what the user asked for?","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel","LabelPosition":"BELOW"},"QuestionDescription":"Did the response address what the user asked for?","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"SubSelector":"TX","QuestionText_Unsafe":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DataExportTag":"P04_V2_A_Helpful","QuestionID":"QID166"}},{"SurveyID":"SV_elJCHDTDWBcCbD8","Element":"SQ","PrimaryAttribute":"QID167","SecondaryAttribute":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DataExportTag":"P04_V2_A_Clarity","QuestionID":"QID167"}},{"SurveyID":"SV_elJCHDTDWBcCbD8","Element":"SQ","PrimaryAttribute":"QID168","SecondaryAttribute":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br>\n<em>1 = Very Cold, 3 = Neutral, 5 = Very Warm&nbsp;<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br \/>\n<em>1 = Very Cold, 3 = Nuetral, 5 = Very Warm&nbsp;<\/em>","DataExportTag":"P04_V2_A_Warmth","QuestionID":"QID168"}},{"SurveyID":"SV_elJCHDTDWBcCbD8","Element":"SQ","PrimaryAttribute":"QID169","SecondaryAttribute":"Response A: It\u2019s really understandable to feel that way\u2014sometimes humor, especially when it\u2019s ","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response A:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">It\u2019s really understandable to feel that way\u2014sometimes humor, especially when it\u2019s playful or a little rough around the edges, can be hard to interpret. The line between joking and disrespect can be subtle, and it\u2019s totally normal to reflect on interactions after the fact.<\/p><p style=\"margin:0 0 12px 0;\">Here are some ways to help tell the difference:<\/p><p style=\"margin:0 0 12px 0;\"><strong>1. Pay attention to tone and context.<\/strong><\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Jokes among friends can be teasing, but usually the tone is light and everyone\u2019s in on the fun.  <\/li><li style=\"margin:0 0 4px 0;\">If the person\u2019s tone felt sharp, or if the joke singled you out in a way that made you uncomfortable (especially if it happens repeatedly), that could be a red flag.<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>2. Think about your relationship with the person.<\/strong><\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Good friends usually know your boundaries and don\u2019t want to cross them.  <\/li><li style=\"margin:0 0 4px 0;\">If the person rarely jokes with others the way they joke with you, or if their comments tend to put you down, that might be less about fun and more about disrespect.<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>3. Reflect on how you felt in the moment and afterward.<\/strong><\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">If you laughed at the time but later felt uneasy, that\u2019s a sign your gut is picking up that something wasn\u2019t right for you.  <\/li><li style=\"margin:0 0 4px 0;\">Trusting your own feelings is important\u2014even if others laughed too.<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>4. Notice patterns.<\/strong><\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Does this person often make jokes at your expense, especially when others are around?  <\/li><li style=\"margin:0 0 4px 0;\">Occasional playful teasing is normal, but a consistent pattern of jokes that feel \u201coff\u201d could mean it\u2019s more about putting you down.<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>5. Consider intention vs. impact.<\/strong><\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Sometimes someone might mean it as a joke, but it still feels hurtful or disrespectful.  <\/li><li style=\"margin:0 0 4px 0;\">Even if their intention wasn\u2019t bad, your feelings are valid.<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>What you can do:<\/strong><\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">If you\u2019re close with the person, you might bring it up (\u201cHey, when you said __, I wasn\u2019t sure if you were joking. It kind of stuck with me.\u201d).  <\/li><li style=\"margin:0 0 4px 0;\">You could also let them know which types of jokes you\u2019re cool with and which you aren\u2019t.<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>Bottom line:<\/strong> If you\u2019re questioning whether it was disrespectful, that feeling is worth listening to, even if you decide not to say anything right away. Setting boundaries is your right, and people who care about you will want to respect them. If you\u2019re ever unsure, talking it through with a friend you trust can also help you get perspective.<\/p><p style=\"margin:0 0 12px 0;\">You\u2019re not alone in feeling this way\u2014these situations can be tricky for anyone.<\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Response A: It\u2019s really understandable to feel that way\u2014sometimes humor, especially when it\u2019s pla...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Response B:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">The first project that sent Americans into space was <strong>Project Mercury<\/strong>.<\/p><p style=\"margin:0 0 12px 0;\"><strong>Project Mercury<\/strong> was the United States' first human spaceflight program, conducted by NASA. Its main goal was to put a human in orbit around the Earth and return them safely. The first American in space, astronaut <strong>Alan Shepard<\/strong>, flew on the <strong>Mercury-Redstone 3 mission<\/strong> (also known as Freedom 7) on May 5, 1961. Later, John Glenn became the first American to orbit the Earth on Mercury-Atlas 6 (Friendship 7) in February 1962.<\/p><p style=\"margin:0 0 12px 0;\">So, <strong>Project Mercury<\/strong> is the correct answer.<\/p><\/div>","DataExportTag":"P04_V2_ResponseA","QuestionID":"QID169"}},{"SurveyID":"SV_elJCHDTDWBcCbD8","Element":"SQ","PrimaryAttribute":"QID17","SecondaryAttribute":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","TertiaryAttribute":null,"Payload":{"QuestionText":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","DefaultChoices":false,"DataExportTag":"Template_Appropriate","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","Choices":{"1":{"Display":"Neither response"},"2":{"Display":"Response A"},"3":{"Display":"Response B"},"4":{"Display":"Both"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID17"}},{"SurveyID":"SV_elJCHDTDWBcCbD8","Element":"SQ","PrimaryAttribute":"QID170","SecondaryAttribute":"In the next few questions, rate Response B based on your overall impression, including both its c...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, rate Response B based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, rate Response B based on your overall impression, including both its c...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, rate Response B based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P04_Tones_B","QuestionID":"QID170"}},{"SurveyID":"SV_elJCHDTDWBcCbD8","Element":"SQ","PrimaryAttribute":"QID171","SecondaryAttribute":"Did the response address what the user asked for?\u00a01 = Not at all, 3 = Partially, 5 = Completely","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Did the response address what the user asked for?\u00a01 = Not at all, 3 = Partially, 5 = Completely","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DataExportTag":"P04_V2_B_Helpful","QuestionID":"QID171"}},{"SurveyID":"SV_elJCHDTDWBcCbD8","Element":"SQ","PrimaryAttribute":"QID172","SecondaryAttribute":"How easy is the response to u