iption":"Which response do you prefer?","Choices":{"1":{"Display":"Response A"},"2":{"Display":"Response B"},"3":{"Display":"No Preference"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":3,"QuestionText_Unsafe":"Which response do you prefer?","DataExportTag":"P04_V2_Preference","QuestionID":"QID175"}},{"SurveyID":"SV_elJCHDTDWBcCbD8","Element":"SQ","PrimaryAttribute":"QID176","SecondaryAttribute":"Why did you prefer one response over the other, or neither? Please explain your reasoning, includ...","TertiaryAttribute":null,"Payload":{"QuestionText":"Why did you prefer one response over the other, or neither? Please explain your reasoning, including what you liked or disliked about each response.","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Why did you prefer one response over the other, or neither? Please explain your reasoning, includ...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"Why did you prefer one response over the other, or neither? Please explain your reasoning, including what you liked or disliked about each response.","DataExportTag":"P04_V2_PreferenceWhy","QuestionID":"QID176"}},{"SurveyID":"SV_elJCHDTDWBcCbD8","Element":"SQ","PrimaryAttribute":"QID177","SecondaryAttribute":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","TertiaryAttribute":null,"Payload":{"QuestionText":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private"