/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, please keep in mind your overall impression of Response A & Response B...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, please keep in mind your overall impression of Response A &amp; Response B, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P07_Both","QuestionID":"QID254"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID255","SecondaryAttribute":"Which response do you prefer?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which response do you prefer?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"QuestionDescription":"Which response do you prefer?","Choices":{"1":{"Display":"Response A"},"2":{"Display":"Response B"},"3":{"Display":"No Preference"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":3,"QuestionText_Unsafe":"Which response do you prefer?","DataExportTag":"P07_V1_Preference","QuestionID":"QID255"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID256","SecondaryAttribute":"Why did you prefer one response over the other, or neither? Please explain your reasoning, includ...","TertiaryAttribute":null,"Payload":{"QuestionText":"Why did you prefer one response over the other, or neither? Please explain your reasoning, including what you liked or disliked about each response.","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Why did you prefer one response over the other, or neither? Please explain your reasoning, includ...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"Why did you prefer one response over the other, or neither? Please explain your reasoning, including what you liked or disliked about each response.","DataExportTag":"P07_V1_PreferenceWhy","QuestionID":"QID256"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID257","SecondaryAttribute":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","TertiaryAttribute":null,"Payload":{"QuestionText":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","Choices":{"1":{"Display":"Neither response"},"2":{"Display":"Response A"},"3":{"Display":"Response B"},"4":{"Display":"Both"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionText_Unsafe":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","DataExportTag":"P07_V1_Approp","QuestionID":"QID257"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID258","SecondaryAttribute":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise social...","TertiaryAttribute":null,"Payload":{"QuestionText":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise socially inappropriate.","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise social...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None","MinChars":"1"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"InPageDisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID257\/SelectableChoice\/2","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Response A<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID257\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID257","QuestionIDFromLocator":"QID257","QuestionIsInLoop":"no","Type":"Expression"},"1":{"ChoiceLocator":"q:\/\/QID257\/SelectableChoice\/3","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Response B<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID257\/SelectableChoice\/3","LogicType":"Question","Operator":"Selected","QuestionID":"QID257","QuestionIDFromLocator":"QID257","QuestionIsInLoop":"no","Type":"Expression"},"2":{"ChoiceLocator":"q:\/\/QID257\/SelectableChoice\/4","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Both<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID257\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID257","QuestionIDFromLocator":"QID257","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":true},"QuestionText_Unsafe":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise socially inappropriate.","DataExportTag":"P07_V1_AppropWhy","QuestionID":"QID258"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID259","SecondaryAttribute":"Prompt","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Prompt 7:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">Why is it that my Iphone dies before it reaches 0% battery, it sometimes even dies at 20%?<\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"QuestionDescription":"Prompt","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Prompt 7:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">Why is it that my Iphone dies before it reaches 0% battery, it sometimes even dies at 20%?<\/p><\/div>","DataExportTag":"P07","QuestionID":"QID259"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID26","SecondaryAttribute":"In the next few questions, rate Response B based on your overall impression, including both its c...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, rate Response B based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, rate Response B based on your overall impression, including both its c...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, rate Response B based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P01_Tones_B","QuestionID":"QID26"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID260","SecondaryAttribute":"Response B: When your iPhone dies before reaching 0% battery\u2014sometimes even as high as 20%\u2014it's ","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response B:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">When your iPhone dies before reaching 0% battery\u2014sometimes even as high as 20%\u2014it's usually a sign that your battery is aging or there is a calibration issue. Here\u2019s why this happens:<\/p><h3 style=\"margin:12px 0 8px 0;\">1. <strong>Battery Degradation<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\"><strong>Lithium-ion batteries<\/strong> (which iPhones use) naturally lose capacity over time.<\/li><li style=\"margin:0 0 4px 0;\">As they age, their ability to <strong>hold a charge and report the charge level accurately<\/strong> diminishes.<\/li><li style=\"margin:0 0 4px 0;\">Your phone might think there\u2019s 20% left, but the actual <strong>charge is much lower<\/strong>, causing a shutdown.<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">2. <strong>Battery Calibration Issues<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">The battery percentage display relies on software to estimate remaining charge.<\/li><li style=\"margin:0 0 4px 0;\">If you frequently charge in short bursts, or rarely let your phone run down, the software estimate can get out of sync with the actual capacity.<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">3. <strong>Cold or Hot Temperatures<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Extreme temperatures can cause the battery to behave unpredictably and even shut down prematurely.<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">4. <strong>High Power Demands<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">If you suddenly use a demanding app or feature (like the camera or gaming) while the battery is low, the phone may shut off because it can\u2019t keep up with the power draw.<\/li><\/ul><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><h2 style=\"margin:12px 0 8px 0;\"><strong>What Can You Do?<\/strong><\/h2><h3 style=\"margin:12px 0 8px 0;\"><strong>Check Battery Health<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">On your iPhone: <code style=\"font-family: Menlo, Consolas, monospace;\">Settings \u2192 Battery \u2192 Battery Health & Charging<\/code><\/li><li style=\"margin:0 0 4px 0;\">If it says \u201cService\u201d or the maximum capacity is significantly below 80%, <strong>it\u2019s time to replace the battery.<\/strong><\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\"><strong>Recalibrate the Battery<\/strong><\/h3><ol style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Use your iPhone until it shuts off due to low battery.<\/li><li style=\"margin:0 0 4px 0;\">Charge it uninterrupted to 100%.<\/li><li style=\"margin:0 0 4px 0;\">Repeat if necessary.<\/li><\/ol><h3 style=\"margin:12px 0 8px 0;\"><strong>Preventative Tips<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Avoid exposing your phone to heat\/cold.<\/li><li style=\"margin:0 0 4px 0;\">Avoid letting it die frequently (extreme lows and highs aren\u2019t good for lithium batteries).<\/li><li style=\"margin:0 0 4px 0;\">Use official or certified charging accessories.<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\"><strong>If the Issue Persists<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">The battery may need replacement.<\/li><li style=\"margin:0 0 4px 0;\">If in doubt, visit an Apple Store or authorized service provider for advice.<\/li><\/ul><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><p style=\"margin:0 0 12px 0;\"><strong>In short:<\/strong> The problem is almost always due to aging, miscalibrated, or damaged batteries. If your iPhone is more than 2-3 years old and showing these symptoms, a battery replacement will likely fix it.<\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Response B: When your iPhone dies before reaching 0% battery\u2014sometimes even as high as 20%\u2014it's u...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Response A:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">When your iPhone dies before reaching 0% battery\u2014sometimes even as high as 20%\u2014it's usually a sign that your battery is aging or there is a calibration issue. Here\u2019s why this happens:<\/p><h3 style=\"margin:12px 0 8px 0;\">1. <strong>Battery Degradation<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\"><strong>Lithium-ion batteries<\/strong> (which iPhones use) naturally lose capacity over time.<\/li><li style=\"margin:0 0 4px 0;\">As they age, their ability to <strong>hold a charge and report the charge level accurately<\/strong> diminishes.<\/li><li style=\"margin:0 0 4px 0;\">Your phone might think there\u2019s 20% left, but the actual <strong>charge is much lower<\/strong>, causing a shutdown.<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">2. <strong>Battery Calibration Issues<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">The battery percentage display relies on software to estimate remaining charge.<\/li><li style=\"margin:0 0 4px 0;\">If you frequently charge in short bursts, or rarely let your phone run down, the software estimate can get out of sync with the actual capacity.<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">3. <strong>Cold or Hot Temperatures<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Extreme temperatures can cause the battery to behave unpredictably and even shut down prematurely.<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">4. <strong>High Power Demands<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">If you suddenly use a demanding app or feature (like the camera or gaming) while the battery is low, the phone may shut off because it can\u2019t keep up with the power draw.<\/li><\/ul><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><h2 style=\"margin:12px 0 8px 0;\"><strong>What Can You Do?<\/strong><\/h2><h3 style=\"margin:12px 0 8px 0;\"><strong>Check Battery Health<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">On your iPhone: <code style=\"font-family: Menlo, Consolas, monospace;\">Settings \u2192 Battery \u2192 Battery Health &amp;amp; Charging<\/code><\/li><li style=\"margin:0 0 4px 0;\">If it says \u201cService\u201d or the maximum capacity is significantly below 80%, <strong>it\u2019s time to replace the battery.<\/strong><\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\"><strong>Recalibrate the Battery<\/strong><\/h3><ol style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Use your iPhone until it shuts off due to low battery.<\/li><li style=\"margin:0 0 4px 0;\">Charge it uninterrupted to 100%.<\/li><li style=\"margin:0 0 4px 0;\">Repeat if necessary.<\/li><\/ol><h3 style=\"margin:12px 0 8px 0;\"><strong>Preventative Tips<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Avoid exposing your phone to heat\/cold.<\/li><li style=\"margin:0 0 4px 0;\">Avoid letting it die frequently (extreme lows and highs aren\u2019t good for lithium batteries).<\/li><li style=\"margin:0 0 4px 0;\">Use official or certified charging accessories.<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\"><strong>If the Issue Persists<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">The battery may need replacement.<\/li><li style=\"margin:0 0 4px 0;\">If in doubt, visit an Apple Store or authorized service provider for advice.<\/li><\/ul><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><p style=\"margin:0 0 12px 0;\"><strong>In short:<\/strong> The problem is almost always due to aging, miscalibrated, or damaged batteries. If your iPhone is more than 2-3 years old and showing these symptoms, a battery replacement will likely fix it.<\/p><\/div>","DataExportTag":"P07_V2_ResponseB","QuestionID":"QID260"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID261","SecondaryAttribute":"In the next few questions, rate Response A based on your overall impression, including both its c...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, rate Response A based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, rate Response A based on your overall impression, including both its c...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, rate Response A based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P07_Tones_A","QuestionID":"QID261"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID262","SecondaryAttribute":"Did the response address what the user asked for?","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel","LabelPosition":"BELOW"},"QuestionDescription":"Did the response address what the user asked for?","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"SubSelector":"TX","QuestionText_Unsafe":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DataExportTag":"P07_V2_A_Helpful","QuestionID":"QID262"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID263","SecondaryAttribute":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DataExportTag":"P07_V2_A_Clarity","QuestionID":"QID263"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID264","SecondaryAttribute":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br>\n<em>1 = Very Cold, 3 = Neutral, 5 = Very Warm&nbsp;<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br \/>\n<em>1 = Very Cold, 3 = Nuetral, 5 = Very Warm&nbsp;<\/em>","DataExportTag":"P07_V2_A_Warmth","QuestionID":"QID264"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID265","SecondaryAttribute":"Response A: If your iPhone is shutting down before the battery reaches 0%\u2014sometimes even at 20%\u2014","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response A:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">If your iPhone is shutting down <strong>before<\/strong> the battery reaches 0%\u2014sometimes even at 20%\u2014that\u2019s a sign <strong>the battery is likely degraded<\/strong> or there's a calibration issue. This is pretty common in older devices or devices with worn-out batteries.<\/p><h3 style=\"margin:12px 0 8px 0;\"><strong>Why is this happening?<\/strong><\/h3><h4 style=\"margin:12px 0 8px 0;\"><strong>1. Battery Aging<\/strong><\/h4><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Lithium-ion batteries wear out over time, usually after a couple of years or a certain number of charge cycles.<\/li><li style=\"margin:0 0 4px 0;\">As they age, their ability to <strong>hold a charge<\/strong> and provide consistent voltage drops, causing unexpected shutdowns.<\/li><\/ul><h4 style=\"margin:12px 0 8px 0;\"><strong>2. Battery Calibration Issue<\/strong><\/h4><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Sometimes, the battery percentage displayed becomes <strong>inaccurate<\/strong> and doesn\u2019t reflect the actual charge remaining, leading the phone to shut off when it thinks it's still at 20%.<\/li><\/ul><h4 style=\"margin:12px 0 8px 0;\"><strong>3. Extreme Temperatures<\/strong><\/h4><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Using your phone in <strong>very hot or cold<\/strong> environments can make these issues more noticeable.<\/li><\/ul><h4 style=\"margin:12px 0 8px 0;\"><strong>4. Software Issues<\/strong><\/h4><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Occasionally, iOS glitches or bugs might cause inaccurate charge readings.<\/li><\/ul><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><h2 style=\"margin:12px 0 8px 0;\"><strong>How to FIX it<\/strong><\/h2><h3 style=\"margin:12px 0 8px 0;\"><strong>1. Check Battery Health<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Go to <strong>Settings &gt; Battery &gt; Battery Health<\/strong> (or Battery Health &amp; Charging, in iOS 16+).<\/li><li style=\"margin:0 0 4px 0;\">If <strong>Maximum Capacity<\/strong> is below 80% or it says <strong>\u201cService\u201d<\/strong>, your battery is degraded.<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\"><strong>2. Calibrate the Battery<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">Try to recalibrate the battery:<\/p><ol style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Charge your iPhone to 100% (leave it plugged in for an extra hour after it reaches 100%).<\/li><li style=\"margin:0 0 4px 0;\">Use your phone until it <strong>dies completely<\/strong> (shuts down on its own).<\/li><li style=\"margin:0 0 4px 0;\"><strong>Charge it uninterrupted to 100%<\/strong> again.<\/li><\/ol><p style=\"margin:0 0 12px 0;\">This sometimes helps the software re-learn what 0% and 100% truly are.<\/p><h3 style=\"margin:12px 0 8px 0;\"><strong>3. Avoid Extreme Temperatures<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">Keep your phone away from very hot or cold places while using or charging.<\/p><h3 style=\"margin:12px 0 8px 0;\"><strong>4. Update iOS<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">Sometimes Apple releases updates that address battery issues. Check for updates in <strong>Settings &gt; General &gt; Software Update<\/strong>.<\/p><h3 style=\"margin:12px 0 8px 0;\"><strong>5. Replace the Battery<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">If calibration doesn't help AND battery health shows as degraded (below 80% or \u201cService\u201d), you should consider a <strong>battery replacement<\/strong>. You can do this:<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">At an <strong>Apple Store<\/strong><\/li><li style=\"margin:0 0 4px 0;\">At an <strong>authorized service provider<\/strong><\/li><li style=\"margin:0 0 4px 0;\">Or third-party repair shops (less recommended for newer devices).<\/li><\/ul><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><h2 style=\"margin:12px 0 8px 0;\"><strong>Bottom Line<\/strong><\/h2><p style=\"margin:0 0 12px 0;\"><strong>Most likely your battery is worn out or needs recalibrating.<\/strong> If the problem doesn't go away after calibrating and updating, replacing the battery will usually fix it!<\/p><p style=\"margin:0 0 12px 0;\">Let me know if you need steps for your specific iPhone model!<\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Response A: If your iPhone is shutting down before the battery reaches 0%\u2014sometimes even at 20%\u2014t...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Response B:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">If your iPhone is shutting down <strong>before<\/strong> the battery reaches 0%\u2014sometimes even at 20%\u2014that\u2019s a sign <strong>the battery is likely degraded<\/strong> or there's a calibration issue. This is pretty common in older devices or devices with worn-out batteries.<\/p><h3 style=\"margin:12px 0 8px 0;\"><strong>Why is this happening?<\/strong><\/h3><h4 style=\"margin:12px 0 8px 0;\"><strong>1. Battery Aging<\/strong><\/h4><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Lithium-ion batteries wear out over time, usually after a couple of years or a certain number of charge cycles.<\/li><li style=\"margin:0 0 4px 0;\">As they age, their ability to <strong>hold a charge<\/strong> and provide consistent voltage drops, causing unexpected shutdowns.<\/li><\/ul><h4 style=\"margin:12px 0 8px 0;\"><strong>2. Battery Calibration Issue<\/strong><\/h4><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Sometimes, the battery percentage displayed becomes <strong>inaccurate<\/strong> and doesn\u2019t reflect the actual charge remaining, leading the phone to shut off when it thinks it's still at 20%.<\/li><\/ul><h4 style=\"margin:12px 0 8px 0;\"><strong>3. Extreme Temperatures<\/strong><\/h4><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Using your phone in <strong>very hot or cold<\/strong> environments can make these issues more noticeable.<\/li><\/ul><h4 style=\"margin:12px 0 8px 0;\"><strong>4. Software Issues<\/strong><\/h4><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Occasionally, iOS glitches or bugs might cause inaccurate charge readings.<\/li><\/ul><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><h2 style=\"margin:12px 0 8px 0;\"><strong>How to FIX it<\/strong><\/h2><h3 style=\"margin:12px 0 8px 0;\"><strong>1. Check Battery Health<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Go to <strong>Settings &gt; Battery &gt; Battery Health<\/strong> (or Battery Health &amp; Charging, in iOS 16+).<\/li><li style=\"margin:0 0 4px 0;\">If <strong>Maximum Capacity<\/strong> is below 80% or it says <strong>\u201cService\u201d<\/strong>, your battery is degraded.<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\"><strong>2. Calibrate the Battery<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">Try to recalibrate the battery:<\/p><ol style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Charge your iPhone to 100% (leave it plugged in for an extra hour after it reaches 100%).<\/li><li style=\"margin:0 0 4px 0;\">Use your phone until it <strong>dies completely<\/strong> (shuts down on its own).<\/li><li style=\"margin:0 0 4px 0;\"><strong>Charge it uninterrupted to 100%<\/strong> again.<\/li><\/ol><p style=\"margin:0 0 12px 0;\">This sometimes helps the software re-learn what 0% and 100% truly are.<\/p><h3 style=\"margin:12px 0 8px 0;\"><strong>3. Avoid Extreme Temperatures<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">Keep your phone away from very hot or cold places while using or charging.<\/p><h3 style=\"margin:12px 0 8px 0;\"><strong>4. Update iOS<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">Sometimes Apple releases updates that address battery issues. Check for updates in <strong>Settings &gt; General &gt; Software Update<\/strong>.<\/p><h3 style=\"margin:12px 0 8px 0;\"><strong>5. Replace the Battery<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">If calibration doesn't help AND battery health shows as degraded (below 80% or \u201cService\u201d), you should consider a <strong>battery replacement<\/strong>. You can do this:<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">At an <strong>Apple Store<\/strong><\/li><li style=\"margin:0 0 4px 0;\">At an <strong>authorized service provider<\/strong><\/li><li style=\"margin:0 0 4px 0;\">Or third-party repair shops (less recommended for newer devices).<\/li><\/ul><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><h2 style=\"margin:12px 0 8px 0;\"><strong>Bottom Line<\/strong><\/h2><p style=\"margin:0 0 12px 0;\"><strong>Most likely your battery is worn out or needs recalibrating.<\/strong> If the problem doesn't go away after calibrating and updating, replacing the battery will usually fix it!<\/p><p style=\"margin:0 0 12px 0;\">Let me know if you need steps for your specific iPhone model!<\/p><\/div>","DataExportTag":"P07_V2_ResponseA","QuestionID":"QID265"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID266","SecondaryAttribute":"In the next few questions, rate Response B based on your overall impression, including both its c...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, rate Response B based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, rate Response B based on your overall impression, including both its c...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, rate Response B based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P07_Tones_B","QuestionID":"QID266"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID267","SecondaryAttribute":"Did the response address what the user asked for?\u00a01 = Not at all, 3 = Partially, 5 = Completely","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Did the response address what the user asked for?\u00a01 = Not at all, 3 = Partially, 5 = Completely","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DataExportTag":"P07_V2_B_Helpful","QuestionID":"QID267"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID268","SecondaryAttribute":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DataExportTag":"P07_V2_B_Clarity","QuestionID":"QID268"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID269","SecondaryAttribute":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br>\n<em>1 = Very Cold, 3 = Neutral, 5 = Very Warm&nbsp;<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br \/>\n<em>1 = Very Cold, 3 = Nuetral, 5 = Very Warm&nbsp;<\/em>","DataExportTag":"P07_V2_B_Warmth","QuestionID":"QID269"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID27","SecondaryAttribute":"Did the response address what the user asked for?\u00a01 = Not at all, 3 = Partially, 5 = Completely","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Did the response address what the user asked for?\u00a01 = Not at all, 3 = Partially, 5 = Completely","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DataExportTag":"P01_V1_B_Helpful","QuestionID":"QID27"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID270","SecondaryAttribute":"In the next few questions, please keep in mind your overall impression of Response A & Response B...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, please keep in mind your overall impression of Response A &amp; Response B, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, please keep in mind your overall impression of Response A & Response B...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, please keep in mind your overall impression of Response A &amp; Response B, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P07_Both","QuestionID":"QID270"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID271","SecondaryAttribute":"Which response do you prefer?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which response do you prefer?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"QuestionDescription":"Which response do you prefer?","Choices":{"1":{"Display":"Response A"},"2":{"Display":"Response B"},"3":{"Display":"No Preference"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":3,"QuestionText_Unsafe":"Which response do you prefer?","DataExportTag":"P07_V2_Preference","QuestionID":"QID271"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID272","SecondaryAttribute":"Why did you prefer one response over the other, or neither? Please explain your reasoning, includ...","TertiaryAttribute":null,"Payload":{"QuestionText":"Why did you prefer one response over the other, or neither? Please explain your reasoning, including what you liked or disliked about each response.","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Why did you prefer one response over the other, or neither? Please explain your reasoning, includ...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"Why did you prefer one response over the other, or neither? Please explain your reasoning, including what you liked or disliked about each response.","DataExportTag":"P07_V2_PreferenceWhy","QuestionID":"QID272"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID273","SecondaryAttribute":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","TertiaryAttribute":null,"Payload":{"QuestionText":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","Choices":{"1":{"Display":"Neither response"},"2":{"Display":"Response A"},"3":{"Display":"Response B"},"4":{"Display":"Both"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionText_Unsafe":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","DataExportTag":"P07_V2_Approp","QuestionID":"QID273"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID274","SecondaryAttribute":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise social...","TertiaryAttribute":null,"Payload":{"QuestionText":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise socially inappropriate.","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise social...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None","MinChars":"1"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"InPageDisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID273\/SelectableChoice\/2","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Response A<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID273\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID273","QuestionIDFromLocator":"QID273","QuestionIsInLoop":"no","Type":"Expression"},"1":{"ChoiceLocator":"q:\/\/QID273\/SelectableChoice\/3","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Response B<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID273\/SelectableChoice\/3","LogicType":"Question","Operator":"Selected","QuestionID":"QID273","QuestionIDFromLocator":"QID273","QuestionIsInLoop":"no","Type":"Expression"},"2":{"ChoiceLocator":"q:\/\/QID273\/SelectableChoice\/4","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Both<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID273\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID273","QuestionIDFromLocator":"QID273","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":true},"QuestionText_Unsafe":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise socially inappropriate.","DataExportTag":"P07_V2_AppropWhy","QuestionID":"QID274"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID275","SecondaryAttribute":"Prompt","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Prompt 8:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">When I delete a picture or program, what actually happens to it?<\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"QuestionDescription":"Prompt","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Prompt 7:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">Why is it that my Iphone dies before it reaches 0% battery, it sometimes even dies at 20%?<\/p><\/div>","DataExportTag":"P08","QuestionID":"QID275"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID276","SecondaryAttribute":"Response A: Great question! When you delete a picture or program on your computer, phone, or othe...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response A:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">Great question! When you <strong>delete a picture or program<\/strong> on your computer, phone, or other digital device, a few things happen under the hood. Here\u2019s a simple breakdown:<\/p><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><h3 style=\"margin:12px 0 8px 0;\">1. <strong>Deleting from Your Device<\/strong><\/h3><p style=\"margin:0 0 12px 0;\"><strong>Computer (e.g., Windows Trash Bin\/Recycling Bin, macOS Trash):<\/strong><\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">When you hit \u201cdelete,\u201d the file isn\u2019t wiped from the drive immediately.<\/li><li style=\"margin:0 0 4px 0;\">Instead, the <em>space where it\u2019s stored<\/em> is simply marked as \u201cavailable\u201d for new data.<\/li><li style=\"margin:0 0 4px 0;\">The file may remain in a <strong>recycling bin\/trash<\/strong> folder until you empty it.<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>Smartphones\/Tablets:<\/strong><\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Deleted photos often go to a \u201cRecently Deleted\u201d or \u201cTrash\u201d album for 30-60 days before being permanently deleted.<\/li><\/ul><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><h3 style=\"margin:12px 0 8px 0;\">2. <strong>What REALLY Happens<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">The \u201cpointer\u201d or directory entry is removed, so the file is no longer visible to everyday users or most programs.<\/li><li style=\"margin:0 0 4px 0;\">The actual bits of the file <strong>sit on your storage media<\/strong> (hard drive, SSD, flash memory) until that space gets overwritten by new data.<\/li><\/ul><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><h3 style=\"margin:12px 0 8px 0;\">3. <strong>Permanently Deleting<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">When you empty the trash\/recycle bin, or delete a file permanently:<ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">The system still usually just marks the space as reusable.<\/li><li style=\"margin:0 0 4px 0;\">The data can still be recovered with special recovery tools until the space actually gets overwritten.<\/li><\/ul><\/li><\/ul><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><h3 style=\"margin:12px 0 8px 0;\">4. <strong>Why Doesn\u2019t It Vanish Instantly?<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Overwriting data immediately <strong>would take extra time and wear out your drive more quickly<\/strong>.<\/li><li style=\"margin:0 0 4px 0;\">This approach makes deleting files look instant and keeps your device running smoothly.<\/li><\/ul><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><h3 style=\"margin:12px 0 8px 0;\">5. <strong>Special Cases<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\"><strong>Solid State Drives (SSDs)<\/strong> and newer operating systems use a command called <strong>TRIM<\/strong> to more efficiently clear deleted data, but even then, recovery might be possible for a while.<\/li><li style=\"margin:0 0 4px 0;\"><strong>Cloud services<\/strong> (Google Photos, OneDrive, etc.) usually have a similar \"trash\" period; files may also persist in backups for a time.<\/li><li style=\"margin:0 0 4px 0;\"><strong>Uninstalling programs<\/strong> typically just removes system references and associated files, but might also leave behind leftovers (e.g., settings, cache).<\/li><\/ul><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><h3 style=\"margin:12px 0 8px 0;\">6. <strong>If You Want to Make Sure It\u2019s Gone<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Use secure \"shredding\" tools or built-in utilities (\"Secure Erase\") to overwrite the file\u2019s data, making recovery extremely difficult.<\/li><\/ul><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><h3 style=\"margin:12px 0 8px 0;\"><strong>In a Nutshell<\/strong><\/h3><blockquote style=\"margin:8px 0 12px 0; padding:0 0 0 12px; border-left:3px solid #d0d7de;\"><p style=\"margin:0;\"><strong>Deleting just tells your device \u201cyou can use this space for something else.\u201d The data sticks around until it\u2019s overwritten.<\/strong><\/p><\/blockquote><p style=\"margin:0 0 12px 0;\">If you want to make recovery nearly impossible, you have to <em>securely erase\/wipe<\/em> the data.<\/p><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><p style=\"margin:0 0 12px 0;\"><em>Let me know if you want specifics for your device or how to securely erase files!<\/em><\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Response A: Great question! When you delete a picture or program on your computer, phone, or othe...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Response A:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">If your iPhone is shutting down <strong>before<\/strong> the battery reaches 0%\u2014sometimes even at 20%\u2014that\u2019s a sign <strong>the battery is likely degraded<\/strong> or there's a calibration issue. This is pretty common in older devices or devices with worn-out batteries.<\/p><h3 style=\"margin:12px 0 8px 0;\"><strong>Why is this happening?<\/strong><\/h3><h4 style=\"margin:12px 0 8px 0;\"><strong>1. Battery Aging<\/strong><\/h4><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Lithium-ion batteries wear out over time, usually after a couple of years or a certain number of charge cycles.<\/li><li style=\"margin:0 0 4px 0;\">As they age, their ability to <strong>hold a charge<\/strong> and provide consistent voltage drops, causing unexpected shutdowns.<\/li><\/ul><h4 style=\"margin:12px 0 8px 0;\"><strong>2. Battery Calibration Issue<\/strong><\/h4><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Sometimes, the battery percentage displayed becomes <strong>inaccurate<\/strong> and doesn\u2019t reflect the actual charge remaining, leading the phone to shut off when it thinks it's still at 20%.<\/li><\/ul><h4 style=\"margin:12px 0 8px 0;\"><strong>3. Extreme Temperatures<\/strong><\/h4><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Using your phone in <strong>very hot or cold<\/strong> environments can make these issues more noticeable.<\/li><\/ul><h4 style=\"margin:12px 0 8px 0;\"><strong>4. Software Issues<\/strong><\/h4><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Occasionally, iOS glitches or bugs might cause inaccurate charge readings.<\/li><\/ul><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><h2 style=\"margin:12px 0 8px 0;\"><strong>How to FIX it<\/strong><\/h2><h3 style=\"margin:12px 0 8px 0;\"><strong>1. Check Battery Health<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Go to <strong>Settings &gt; Battery &gt; Battery Health<\/strong> (or Battery Health &amp; Charging, in iOS 16+).<\/li><li style=\"margin:0 0 4px 0;\">If <strong>Maximum Capacity<\/strong> is below 80% or it says <strong>\u201cService\u201d<\/strong>, your battery is degraded.<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\"><strong>2. Calibrate the Battery<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">Try to recalibrate the battery:<\/p><ol style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Charge your iPhone to 100% (leave it plugged in for an extra hour after it reaches 100%).<\/li><li style=\"margin:0 0 4px 0;\">Use your phone until it <strong>dies completely<\/strong> (shuts down on its own).<\/li><li style=\"margin:0 0 4px 0;\"><strong>Charge it uninterrupted to 100%<\/strong> again.<\/li><\/ol><p style=\"margin:0 0 12px 0;\">This sometimes helps the software re-learn what 0% and 100% truly are.<\/p><h3 style=\"margin:12px 0 8px 0;\"><strong>3. Avoid Extreme Temperatures<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">Keep your phone away from very hot or cold places while using or charging.<\/p><h3 style=\"margin:12px 0 8px 0;\"><strong>4. Update iOS<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">Sometimes Apple releases updates that address battery issues. Check for updates in <strong>Settings &gt; General &gt; Software Update<\/strong>.<\/p><h3 style=\"margin:12px 0 8px 0;\"><strong>5. Replace the Battery<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">If calibration doesn't help AND battery health shows as degraded (below 80% or \u201cService\u201d), you should consider a <strong>battery replacement<\/strong>. You can do this:<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">At an <strong>Apple Store<\/strong><\/li><li style=\"margin:0 0 4px 0;\">At an <strong>authorized service provider<\/strong><\/li><li style=\"margin:0 0 4px 0;\">Or third-party repair shops (less recommended for newer devices).<\/li><\/ul><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><h2 style=\"margin:12px 0 8px 0;\"><strong>Bottom Line<\/strong><\/h2><p style=\"margin:0 0 12px 0;\"><strong>Most likely your battery is worn out or needs recalibrating.<\/strong> If the problem doesn't go away after calibrating and updating, replacing the battery will usually fix it!<\/p><p style=\"margin:0 0 12px 0;\">Let me know if you need steps for your specific iPhone model!<\/p><\/div>","DataExportTag":"P08_V1_ResponseA","QuestionID":"QID276"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID277","SecondaryAttribute":"In the next few questions, rate Response A based on your overall impression, including both its c...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, rate Response A based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, rate Response A based on your overall impression, including both its c...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, rate Response A based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P08_Tones_A","QuestionID":"QID277"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID278","SecondaryAttribute":"Did the response address what the user asked for?","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel","LabelPosition":"BELOW"},"QuestionDescription":"Did the response address what the user asked for?","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"SubSelector":"TX","QuestionText_Unsafe":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DataExportTag":"P08_V1_A_Helpful","QuestionID":"QID278"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID279","SecondaryAttribute":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DataExportTag":"P08_V1_A_Clarity","QuestionID":"QID279"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID28","SecondaryAttribute":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DataExportTag":"P01_V1_B_Clarity","QuestionID":"QID28"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID280","SecondaryAttribute":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br>\n<em>1 = Very Cold, 3 = Neutral, 5 = Very Warm&nbsp;<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br \/>\n<em>1 = Very Cold, 3 = Nuetral, 5 = Very Warm&nbsp;<\/em>","DataExportTag":"P08_V1_A_Warmth","QuestionID":"QID280"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID281","SecondaryAttribute":"Response B: Great question! Here\u2019s what happens when you delete a picture or an app on your devic.","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response B:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">Great question! Here\u2019s what happens when you <strong>delete a picture or an app<\/strong> on your device:<\/p><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><h2 style=\"margin:12px 0 8px 0;\">When You Delete a Picture<\/h2><ol style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\"><strong>Removed from Viewing<\/strong>: The photo disappears from your gallery or photo app.<\/li><li style=\"margin:0 0 4px 0;\"><strong>Moved to \u201cTrash\u201d or \u201cRecently Deleted\u201d Folder (most phones\/computers):<\/strong><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">On iPhones and many Androids, deleted photos are moved to a \u201cRecently Deleted\u201d folder for about 30 days before permanent deletion.<\/li><\/ul><\/li><li style=\"margin:0 0 4px 0;\"><strong>Permanent Deletion:<\/strong><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">After the holding period (or if you \"empty trash\" manually), the file\u2019s entry is removed from the file system.<\/li><li style=\"margin:0 0 4px 0;\"><strong>Data Remains on Storage - for a while:<\/strong> <ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">The actual image data isn\u2019t immediately erased. The space it occupied is marked as \u201cavailable\u201d for new data.<\/li><li style=\"margin:0 0 4px 0;\"><strong>Data Recovery Tools<\/strong> sometimes can recover recently deleted files\u2014unless the storage space is overwritten.<\/li><\/ul><\/li><\/ul><\/li><\/ol><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><h2 style=\"margin:12px 0 8px 0;\">When You Delete an App<\/h2><ol style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\"><strong>Icon and App Data Removed:<\/strong>  <ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">The app\u2019s icon disappears from your home screen\/app drawer.<\/li><li style=\"margin:0 0 4px 0;\">App data stored locally is usually deleted.<\/li><\/ul><\/li><li style=\"margin:0 0 4px 0;\"><strong>Account\/Cloud Data Might Stay:<\/strong><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">If you\u2019ve signed up for the app or stored data online (cloud backups, login info), your account and some settings may remain online until you delete them from within the app\/service website.<\/li><\/ul><\/li><li style=\"margin:0 0 4px 0;\"><strong>Storage Freed Up:<\/strong><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">The files used by the app are erased (like with pictures--actually marked as \u201cfree space\u201d).<\/li><li style=\"margin:0 0 4px 0;\">Your device can use that space for other things.<\/li><\/ul><\/li><li style=\"margin:0 0 4px 0;\"><strong>Permissions Revoked:<\/strong><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">The app can no longer access your device\u2019s resources (camera, location, etc.).<\/li><\/ul><\/li><\/ol><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><h2 style=\"margin:12px 0 8px 0;\"><strong>Key Takeaways<\/strong><\/h2><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\"><strong>On the surface:<\/strong> The item disappears from where you usually see it.<\/li><li style=\"margin:0 0 4px 0;\"><strong>Under the hood:<\/strong> The storage space is marked as available, but the actual data lingers until it\u2019s overwritten.<\/li><li style=\"margin:0 0 4px 0;\"><strong>Permanently deleting<\/strong> (overwriting) is sometimes possible with \u201csecure erase\u201d or special tools.<\/li><\/ul><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><h3 style=\"margin:12px 0 8px 0;\"><strong>Tips<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">To ensure sensitive photos or data are unrecoverable, look for \u201csecure delete\u201d options or factory reset the device if you\u2019re giving it away.<\/li><li style=\"margin:0 0 4px 0;\">Deleting an app won\u2019t affect your account data on their servers unless you specifically delete your account through the app or website.<\/li><\/ul><p style=\"margin:0 0 12px 0;\">Let me know if you want more technical details!<\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Response B: Great question! Here\u2019s what happens when you delete a picture or an app on your devic...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Response B:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">When your iPhone dies before reaching 0% battery\u2014sometimes even as high as 20%\u2014it's usually a sign that your battery is aging or there is a calibration issue. Here\u2019s why this happens:<\/p><h3 style=\"margin:12px 0 8px 0;\">1. <strong>Battery Degradation<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\"><strong>Lithium-ion batteries<\/strong> (which iPhones use) naturally lose capacity over time.<\/li><li style=\"margin:0 0 4px 0;\">As they age, their ability to <strong>hold a charge and report the charge level accurately<\/strong> diminishes.<\/li><li style=\"margin:0 0 4px 0;\">Your phone might think there\u2019s 20% left, but the actual <strong>charge is much lower<\/strong>, causing a shutdown.<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">2. <strong>Battery Calibration Issues<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">The battery percentage display relies on software to estimate remaining charge.<\/li><li style=\"margin:0 0 4px 0;\">If you frequently charge in short bursts, or rarely let your phone run down, the software estimate can get out of sync with the actual capacity.<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">3. <strong>Cold or Hot Temperatures<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Extreme temperatures can cause the battery to behave unpredictably and even shut down prematurely.<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">4. <strong>High Power Demands<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">If you suddenly use a demanding app or feature (like the camera or gaming) while the battery is low, the phone may shut off because it can\u2019t keep up with the power draw.<\/li><\/ul><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><h2 style=\"margin:12px 0 8px 0;\"><strong>What Can You Do?<\/strong><\/h2><h3 style=\"margin:12px 0 8px 0;\"><strong>Check Battery Health<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">On your iPhone: <code style=\"font-family: Menlo, Consolas, monospace;\">Settings \u2192 Battery \u2192 Battery Health &amp;amp; Charging<\/code><\/li><li style=\"margin:0 0 4px 0;\">If it says \u201cService\u201d or the maximum capacity is significantly below 80%, <strong>it\u2019s time to replace the battery.<\/strong><\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\"><strong>Recalibrate the Battery<\/strong><\/h3><ol style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Use your iPhone until it shuts off due to low battery.<\/li><li style=\"margin:0 0 4px 0;\">Charge it uninterrupted to 100%.<\/li><li style=\"margin:0 0 4px 0;\">Repeat if necessary.<\/li><\/ol><h3 style=\"margin:12px 0 8px 0;\"><strong>Preventative Tips<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Avoid exposing your phone to heat\/cold.<\/li><li style=\"margin:0 0 4px 0;\">Avoid letting it die frequently (extreme lows and highs aren\u2019t good for lithium batteries).<\/li><li style=\"margin:0 0 4px 0;\">Use official or certified charging accessories.<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\"><strong>If the Issue Persists<\/strong><\/h3><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">The battery may need replacement.<\/li><li style=\"margin:0 0 4px 0;\">If in doubt, visit an Apple Store or authorized service provider for advice.<\/li><\/ul><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><p style=\"margin:0 0 12px 0;\"><strong>In short:<\/strong> The problem is almost always due to aging, miscalibrated, or damaged batteries. If your iPhone is more than 2-3 years old and showing these symptoms, a battery replacement will likely fix it.<\/p><\/div>","DataExportTag":"P08_V1_ResponseB","QuestionID":"QID281"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID282","SecondaryAttribute":"In the next few questions, rate Response B based on your overall impression, including both its c...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, rate Response B based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, rate Response B based on your overall impression, including both its c...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, rate Response B based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P08_Tones_B","QuestionID":"QID282"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID283","SecondaryAttribute":"Did the response address what the user asked for?\u00a01 = Not at all, 3 = Partially, 5 = Completely","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Did the response address what the user asked for?\u00a01 = Not at all, 3 = Partially, 5 = Completely","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DataExportTag":"P08_V1_B_Helpful","QuestionID":"QID283"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID284","SecondaryAttribute":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DataExportTag":"P08_V1_B_Clarity","QuestionID":"QID284"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID285","SecondaryAttribute":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br>\n<em>1 = Very Cold, 3 = Neutral, 5 = Very Warm&nbsp;<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br \/>\n<em>1 = Very Cold, 3 = Nuetral, 5 = Very Warm&nbsp;<\/em>","DataExportTag":"P08_V1_B_Warmth","QuestionID":"QID285"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID286","SecondaryAttribute":"In the next few questions, please keep in mind your overall impression of Response A & Response B...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, please keep in mind your overall impression of Response A &amp; Response B, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, please keep in mind your overall impression of Response A & Response B...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, please keep in mind your overall impression of Response A &amp; Response B, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P08_Both","QuestionID":"QID286"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID287","SecondaryAttribute":"Which response do you prefer?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which response do you prefer?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"QuestionDescription":"Which response do you prefer?","Choices":{"1":{"Display":"Response A"},"2":{"Display":"Response B"},"3":{"Display":"No Preference"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":3,"QuestionText_Unsafe":"Which response do you prefer?","DataExportTag":"P08_V1_Preference","QuestionID":"QID287"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID288","SecondaryAttribute":"Why did you prefer one response over the other, or neither? Please explain your reasoning, includ...","TertiaryAttribute":null,"Payload":{"QuestionText":"Why did you prefer one response over the other, or neither? Please explain your reasoning, including what you liked or disliked about each response.","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Why did you prefer one response over the other, or neither? Please explain your reasoning, includ...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"Why did you prefer one response over the other, or neither? Please explain your reasoning, including what you liked or disliked about each response.","DataExportTag":"P08_V1_PreferenceWhy","QuestionID":"QID288"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID289","SecondaryAttribute":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","TertiaryAttribute":null,"Payload":{"QuestionText":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","Choices":{"1":{"Display":"Neither response"},"2":{"Display":"Response A"},"3":{"Display":"Response B"},"4":{"Display":"Both"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionText_Unsafe":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","DataExportTag":"P08_V1_Approp","QuestionID":"QID28