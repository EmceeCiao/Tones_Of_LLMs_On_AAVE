ext_Unsafe":"Which response do you prefer?","DataExportTag":"P13_V1_Preference","QuestionID":"QID448"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID449","SecondaryAttribute":"Why did you prefer one response over the other, or neither? Please explain your reasoning, includ...","TertiaryAttribute":null,"Payload":{"QuestionText":"Why did you prefer one response over the other, or neither? Please explain your reasoning, including what you liked or disliked about each response.","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Why did you prefer one response over the other, or neither? Please explain your reasoning, includ...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"Why did you prefer one response over the other, or neither? Please explain your reasoning, including what you liked or disliked about each response.","DataExportTag":"P13_V1_PreferenceWhy","QuestionID":"QID449"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID45","SecondaryAttribute":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br>\n<em>1 = Very Cold, 3 = Neutral, 5 = Very Warm&nbsp;<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br \/>\n<em>1 = Very Cold, 3 = Nuetral, 5 = Very Warm&nbsp;<\/em>","DataExportTag":"P01_V2_B_Warmth","QuestionID":"QID45"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID450","SecondaryAttribute":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","TertiaryAttribute":null,"Payload":{"QuestionText":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","Choices":{"1":{"Display":"Neither response"},"2":{"Display":"Response A"},"3":{"Display":"Response B"},"4":{"Display":"Both"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionText_Unsafe":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","DataExportTag":"P13_V1_Approp","QuestionID":"QID450"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID451","SecondaryAttribute":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise social...","TertiaryAttribute":null,"Payload":{"QuestionText":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise socially inappropriate.","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise social...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None","MinChars":"1"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"InPageDisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID450\/SelectableChoice\/2","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Response A<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID450\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID450","QuestionIDFromLocator":"QID450","QuestionIsInLoop":"no","Type":"Expression"},"1":{"ChoiceLocator":"q:\/\/QID450\/SelectableChoice\/3","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Response B<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID450\/SelectableChoice\/3","LogicType":"Question","Operator":"Selected","QuestionID":"QID450","QuestionIDFromLocator":"QID450","QuestionIsInLoop":"no","Type":"Expression"},"2":{"ChoiceLocator":"q:\/\/QID450\/SelectableChoice\/4","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Both<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID450\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID450","QuestionIDFromLocator":"QID450","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":true},"QuestionText_Unsafe":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise socially inappropriate.","DataExportTag":"P13_V1_AppropWhy","QuestionID":"QID451"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID452","SecondaryAttribute":"Prompt","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Prompt 13:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">I emailed my professor a question, and they replied with just \u201cPlease see the syllabus.\u201d Was that rude, and how should I respond?<\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"QuestionDescription":"Prompt","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Prompt 13:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">I emailed my professor a question, and they replied with just \u201cPlease see the syllabus.\u201d Was that rude, and how should I respond?<\/p><\/div>","DataExportTag":"P13","QuestionID":"QID452"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID453","SecondaryAttribute":"Response A: It\u2019s understandable to feel a little brushed off by a \u201cPlease see the syllabus\u201d re","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response A:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">It\u2019s understandable to feel a little brushed off by a \u201cPlease see the syllabus\u201d reply\u2014it <em>can<\/em> feel abrupt! However, many professors receive a huge volume of emails, and they often get questions that are already answered in the syllabus. Their response is probably an effort to encourage students to use the syllabus as a resource and to manage their time effectively.<\/p><p style=\"margin:0 0 12px 0;\"><strong>Is it rude?<\/strong><br>Not necessarily. It\u2019s probably just brief and to the point, rather than intentionally rude.<\/p><p style=\"margin:0 0 12px 0;\"><strong>How should you respond?<\/strong><br>You don\u2019t <em>have<\/em> to reply if your question is answered after checking the syllabus. But if you want to keep things positive (which is always good!), you could send a brief, polite response like:<\/p><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><p style=\"margin:0 0 12px 0;\"><strong>Example response:<\/strong><\/p><blockquote style=\"margin:8px 0 12px 0; padding:0 0 0 12px; border-left:3px solid #d0d7de;\"><p style=\"margin:0;\">Thank you, Professor [Name]. I apologize for missing that information\u2014I\u2019ll be sure to check the syllabus more carefully in the future.<\/p><\/blockquote><p style=\"margin:0 0 12px 0;\">This shows you respect their time and are willing to learn from the interaction.<\/p><p style=\"margin:0 0 12px 0;\"><strong>Going forward\u2026<\/strong><\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Always double-check the syllabus before asking questions.<\/li><li style=\"margin:0 0 4px 0;\">If you can\u2019t find the answer, you can say in your future emails, \u201cI checked the syllabus, but couldn\u2019t find the answer to [specific question],\u201d which shows you did your homework.<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>Summary:<\/strong><br>Their response wasn\u2019t personal! Stay positive and use it as a learning moment. If you want to reply, keep it polite and brief.<\/p><p style=\"margin:0 0 12px 0;\">If you'd like, you can share your original question and I can help you phrase how to follow up if you <em>didn't<\/em> find the answer in the syllabus!<\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Response A: It\u2019s understandable to feel a little brushed off by a \u201cPlease see the syllabus\u201d reply...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Response A:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">It\u2019s understandable to feel a bit dismissed when you get a short reply like \u201cPlease see the syllabus.\u201d However, this response isn\u2019t necessarily rude\u2014it\u2019s actually pretty common in academic settings.<\/p><p style=\"margin:0 0 12px 0;\"><strong>Why professors do this:<\/strong><\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Professors receive a lot of emails, many of which are about information clearly stated in the syllabus.<\/li><li style=\"margin:0 0 4px 0;\">They want to encourage students to read and use the syllabus as a resource, and replying this way is a way to reinforce that habit.<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>How to respond:<\/strong><\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Take a moment to reread the syllabus carefully, focusing on the section relevant to your question.<\/li><li style=\"margin:0 0 4px 0;\">If you find the answer, there\u2019s no need to reply further.<\/li><li style=\"margin:0 0 4px 0;\">If, after checking, your question still isn\u2019t answered or you\u2019re confused by what\u2019s written, you can reply briefly and politely, for example:<\/li><\/ul><blockquote style=\"margin:8px 0 12px 0; padding:0 0 0 12px; border-left:3px solid #d0d7de;\"><p style=\"margin:0;\">Thank you for your reply. I reread the syllabus, but I\u2019m still unclear about [specific part]. Could you please clarify [your specific question]? Thank you for your help!<\/p><\/blockquote><p style=\"margin:0 0 12px 0;\"><strong>Key tips:<\/strong><\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Don\u2019t take it personally; it\u2019s not a reflection of their opinion of you.<\/li><li style=\"margin:0 0 4px 0;\">Always try to find answers in the syllabus or course materials first.<\/li><\/ul><p style=\"margin:0 0 12px 0;\">Let me know if you want help wording your follow-up, or with strategies for making sense of course documents!<\/p><\/div>","DataExportTag":"P13_V2_ResponseA","QuestionID":"QID453"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID454","SecondaryAttribute":"In the next few questions, rate Response A based on your overall impression, including both its c...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, rate Response A based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, rate Response A based on your overall impression, including both its c...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, rate Response A based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P13_Tones_A","QuestionID":"QID454"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID455","SecondaryAttribute":"Did the response address what the user asked for?","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel","LabelPosition":"BELOW"},"QuestionDescription":"Did the response address what the user asked for?","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"SubSelector":"TX","QuestionText_Unsafe":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DataExportTag":"P13_V2_A_Helpful","QuestionID":"QID455"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID456","SecondaryAttribute":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DataExportTag":"P13_V2_A_Clarity","QuestionID":"QID456"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID457","SecondaryAttribute":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br>\n<em>1 = Very Cold, 3 = Neutral, 5 = Very Warm&nbsp;<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br \/>\n<em>1 = Very Cold, 3 = Nuetral, 5 = Very Warm&nbsp;<\/em>","DataExportTag":"P13_V2_A_Warmth","QuestionID":"QID457"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID458","SecondaryAttribute":"Response B: It\u2019s understandable to feel a bit dismissed when you get a short reply like \u201cPlease ","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response B:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">It\u2019s understandable to feel a bit dismissed when you get a short reply like \u201cPlease see the syllabus.\u201d However, this response isn\u2019t necessarily rude\u2014it\u2019s actually pretty common in academic settings.<\/p><p style=\"margin:0 0 12px 0;\"><strong>Why professors do this:<\/strong><\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Professors receive a lot of emails, many of which are about information clearly stated in the syllabus.<\/li><li style=\"margin:0 0 4px 0;\">They want to encourage students to read and use the syllabus as a resource, and replying this way is a way to reinforce that habit.<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>How to respond:<\/strong><\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Take a moment to reread the syllabus carefully, focusing on the section relevant to your question.<\/li><li style=\"margin:0 0 4px 0;\">If you find the answer, there\u2019s no need to reply further.<\/li><li style=\"margin:0 0 4px 0;\">If, after checking, your question still isn\u2019t answered or you\u2019re confused by what\u2019s written, you can reply briefly and politely, for example:<\/li><\/ul><blockquote style=\"margin:8px 0 12px 0; padding:0 0 0 12px; border-left:3px solid #d0d7de;\"><p style=\"margin:0;\">Thank you for your reply. I reread the syllabus, but I\u2019m still unclear about [specific part]. Could you please clarify [your specific question]? Thank you for your help!<\/p><\/blockquote><p style=\"margin:0 0 12px 0;\"><strong>Key tips:<\/strong><\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Don\u2019t take it personally; it\u2019s not a reflection of their opinion of you.<\/li><li style=\"margin:0 0 4px 0;\">Always try to find answers in the syllabus or course materials first.<\/li><\/ul><p style=\"margin:0 0 12px 0;\">Let me know if you want help wording your follow-up, or with strategies for making sense of course documents!<\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Response B: It\u2019s understandable to feel a bit dismissed when you get a short reply like \u201cPlease s...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Response B:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">It\u2019s understandable to feel a little brushed off by a \u201cPlease see the syllabus\u201d reply\u2014it <em>can<\/em> feel abrupt! However, many professors receive a huge volume of emails, and they often get questions that are already answered in the syllabus. Their response is probably an effort to encourage students to use the syllabus as a resource and to manage their time effectively.<\/p><p style=\"margin:0 0 12px 0;\"><strong>Is it rude?<\/strong><br>Not necessarily. It\u2019s probably just brief and to the point, rather than intentionally rude.<\/p><p style=\"margin:0 0 12px 0;\"><strong>How should you respond?<\/strong><br>You don\u2019t <em>have<\/em> to reply if your question is answered after checking the syllabus. But if you want to keep things positive (which is always good!), you could send a brief, polite response like:<\/p><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><p style=\"margin:0 0 12px 0;\"><strong>Example response:<\/strong><\/p><blockquote style=\"margin:8px 0 12px 0; padding:0 0 0 12px; border-left:3px solid #d0d7de;\"><p style=\"margin:0;\">Thank you, Professor [Name]. I apologize for missing that information\u2014I\u2019ll be sure to check the syllabus more carefully in the future.<\/p><\/blockquote><p style=\"margin:0 0 12px 0;\">This shows you respect their time and are willing to learn from the interaction.<\/p><p style=\"margin:0 0 12px 0;\"><strong>Going forward\u2026<\/strong><\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Always double-check the syllabus before asking questions.<\/li><li style=\"margin:0 0 4px 0;\">If you can\u2019t find the answer, you can say in your future emails, \u201cI checked the syllabus, but couldn\u2019t find the answer to [specific question],\u201d which shows you did your homework.<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>Summary:<\/strong><br>Their response wasn\u2019t personal! Stay positive and use it as a learning moment. If you want to reply, keep it polite and brief.<\/p><p style=\"margin:0 0 12px 0;\">If you'd like, you can share your original question and I can help you phrase how to follow up if you <em>didn't<\/em> find the answer in the syllabus!<\/p><\/div>","DataExportTag":"P13_V2_ResponseB","QuestionID":"QID458"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID459","SecondaryAttribute":"In the next few questions, rate Response B based on your overall impression, including both its c...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, rate Response B based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, rate Response B based on your overall impression, including both its c...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, rate Response B based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P13_Tones_B","QuestionID":"QID459"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID46","SecondaryAttribute":"In the next few questions, please keep in mind your overall impression of Response A & Response B...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, please keep in mind your overall impression of Response A &amp; Response B, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, please keep in mind your overall impression of Response A & Response B...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, please keep in mind your overall impression of Response A &amp; Response B, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P01_Both","QuestionID":"QID46"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID460","SecondaryAttribute":"Did the response address what the user asked for?\u00a01 = Not at all, 3 = Partially, 5 = Completely","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Did the response address what the user asked for?\u00a01 = Not at all, 3 = Partially, 5 = Completely","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DataExportTag":"P13_V2_B_Helpful","QuestionID":"QID460"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID461","SecondaryAttribute":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DataExportTag":"P13_V2_B_Clarity","QuestionID":"QID461"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID462","SecondaryAttribute":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br>\n<em>1 = Very Cold, 3 = Neutral, 5 = Very Warm&nbsp;<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br \/>\n<em>1 = Very Cold, 3 = Nuetral, 5 = Very Warm&nbsp;<\/em>","DataExportTag":"P13_V2_B_Warmth","QuestionID":"QID462"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID463","SecondaryAttribute":"In the next few questions, please keep in mind your overall impression of Response A & Response B...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, please keep in mind your overall impression of Response A &amp; Response B, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, please keep in mind your overall impression of Response A & Response B...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, please keep in mind your overall impression of Response A &amp; Response B, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P13_Both","QuestionID":"QID463"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID464","SecondaryAttribute":"Which response do you prefer?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which response do you prefer?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"QuestionDescription":"Which response do you prefer?","Choices":{"1":{"Display":"Response A"},"2":{"Display":"Response B"},"3":{"Display":"No Preference"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":3,"QuestionText_Unsafe":"Which response do you prefer?","DataExportTag":"P13_V2_Preference","QuestionID":"QID464"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID465","SecondaryAttribute":"Why did you prefer one response over the other, or neither? Please explain your reasoning, includ...","TertiaryAttribute":null,"Payload":{"QuestionText":"Why did you prefer one response over the other, or neither? Please explain your reasoning, including what you liked or disliked about each response.","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Why did you prefer one response over the other, or neither? Please explain your reasoning, includ...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"Why did you prefer one response over the other, or neither? Please explain your reasoning, including what you liked or disliked about each response.","DataExportTag":"P13_V2_PreferenceWhy","QuestionID":"QID465"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID466","SecondaryAttribute":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","TertiaryAttribute":null,"Payload":{"QuestionText":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","Choices":{"1":{"Display":"Neither response"},"2":{"Display":"Response A"},"3":{"Display":"Response B"},"4":{"Display":"Both"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionText_Unsafe":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","DataExportTag":"P13_V2_Approp","QuestionID":"QID466"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID467","SecondaryAttribute":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise social...","TertiaryAttribute":null,"Payload":{"QuestionText":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise socially inappropriate.","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise social...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None","MinChars":"1"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"InPageDisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID466\/SelectableChoice\/2","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Response A<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID466\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID466","QuestionIDFromLocator":"QID466","QuestionIsInLoop":"no","Type":"Expression"},"1":{"ChoiceLocator":"q:\/\/QID466\/SelectableChoice\/3","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Response B<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID466\/SelectableChoice\/3","LogicType":"Question","Operator":"Selected","QuestionID":"QID466","QuestionIDFromLocator":"QID466","QuestionIsInLoop":"no","Type":"Expression"},"2":{"ChoiceLocator":"q:\/\/QID466\/SelectableChoice\/4","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Both<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID466\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID466","QuestionIDFromLocator":"QID466","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":true},"QuestionText_Unsafe":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise socially inappropriate.","DataExportTag":"P13_V2_AppropWhy","QuestionID":"QID467"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID468","SecondaryAttribute":"Prompt","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Prompt 14:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">I keep being the one who reaches out first in my friendships, and it's starting to make me feel unwanted. How do I bring that up without sounding needy?<\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"QuestionDescription":"Prompt","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Prompt 13:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">I emailed my professor a question, and they replied with just \u201cPlease see the syllabus.\u201d Was that rude, and how should I respond?<\/p><\/div>","DataExportTag":"P14","QuestionID":"QID468"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID469","SecondaryAttribute":"Response A: That\u2019s a very real and common feeling, and it\u2019s great that you want to address it th","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response A:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">That\u2019s a very real and common feeling, and it\u2019s great that you want to address it thoughtfully. Bringing it up can absolutely be done in a way that\u2019s open and honest without coming across as needy. Here\u2019s how you might approach it:<\/p><p style=\"margin:0 0 12px 0;\"><strong>1. Choose the right time and person:<\/strong><br>Pick a close, trusted friend, and a moment where you can talk privately, not over text if possible\u2014sometimes sensitive conversations go better voice-to-voice.<\/p><p style=\"margin:0 0 12px 0;\"><strong>2. Use \u201cI\u201d statements:<\/strong><br>Frame your feelings from your own perspective. For example:<br><em>\u201cHey, I\u2019ve noticed I\u2019ve been the one reaching out first most of the time, and sometimes it makes me wonder if you still want to hang out as much. I care about our friendship and just wanted to check in\u2014am I overthinking it?\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>3. Avoid accusatory language:<\/strong><br>Don\u2019t say, \u201cYou never text me first\u201d or \u201cYou clearly don\u2019t care.\u201d Instead, stick to what you\u2019ve observed:<br><em>\u201cI realized I usually start our conversations, and I guess I feel a bit self-conscious about it.\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>4. Ask for their perspective:<\/strong><br>Give your friend a chance to respond. They might not realize you feel this way, or there could be a reason for their behavior:<br><em>\u201cIs there a reason you don\u2019t text as much, or is it just how you are in friendships?\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>5. Suggest what you\u2019d like to see:<\/strong><br>Rather than demanding, gently suggest solutions:<br><em>\u201cIt would mean a lot if you\u2019d reach out sometimes too. It helps me feel connected.\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>6. Keep the tone positive:<\/strong><br>Remind them why you value your bond:<br><em>\u201cI really love talking to you and spending time together.\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>Sample script:<\/strong><\/p><blockquote style=\"margin:8px 0 12px 0; padding:0 0 0 12px; border-left:3px solid #d0d7de;\"><p style=\"margin:0;\">\u201cHey! I wanted to share something on my mind\u2014I\u2019ve noticed I usually reach out first, and sometimes it makes me worry I might be bothering you or that you\u2019re less interested in hanging out. I love our friendship and just wanted to check in and see how you feel about it. Is that something you\u2019ve noticed too?\u201d<\/p><\/blockquote><p style=\"margin:0 0 12px 0;\">Friendships do ebb and flow. If your friend responds well, great! If not, it might be a sign to invest energy in people who reciprocate\u2014<strong>but opening the door first is always worth it.<\/strong><\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Response A: That\u2019s a very real and common feeling, and it\u2019s great that you want to address it tho...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Response A:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">It\u2019s understandable to feel a little brushed off by a \u201cPlease see the syllabus\u201d reply\u2014it <em>can<\/em> feel abrupt! However, many professors receive a huge volume of emails, and they often get questions that are already answered in the syllabus. Their response is probably an effort to encourage students to use the syllabus as a resource and to manage their time effectively.<\/p><p style=\"margin:0 0 12px 0;\"><strong>Is it rude?<\/strong><br>Not necessarily. It\u2019s probably just brief and to the point, rather than intentionally rude.<\/p><p style=\"margin:0 0 12px 0;\"><strong>How should you respond?<\/strong><br>You don\u2019t <em>have<\/em> to reply if your question is answered after checking the syllabus. But if you want to keep things positive (which is always good!), you could send a brief, polite response like:<\/p><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><p style=\"margin:0 0 12px 0;\"><strong>Example response:<\/strong><\/p><blockquote style=\"margin:8px 0 12px 0; padding:0 0 0 12px; border-left:3px solid #d0d7de;\"><p style=\"margin:0;\">Thank you, Professor [Name]. I apologize for missing that information\u2014I\u2019ll be sure to check the syllabus more carefully in the future.<\/p><\/blockquote><p style=\"margin:0 0 12px 0;\">This shows you respect their time and are willing to learn from the interaction.<\/p><p style=\"margin:0 0 12px 0;\"><strong>Going forward\u2026<\/strong><\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Always double-check the syllabus before asking questions.<\/li><li style=\"margin:0 0 4px 0;\">If you can\u2019t find the answer, you can say in your future emails, \u201cI checked the syllabus, but couldn\u2019t find the answer to [specific question],\u201d which shows you did your homework.<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>Summary:<\/strong><br>Their response wasn\u2019t personal! Stay positive and use it as a learning moment. If you want to reply, keep it polite and brief.<\/p><p style=\"margin:0 0 12px 0;\">If you'd like, you can share your original question and I can help you phrase how to follow up if you <em>didn't<\/em> find the answer in the syllabus!<\/p><\/div>","DataExportTag":"P14_V1_ResponseA","QuestionID":"QID469"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID47","SecondaryAttribute":"Which response do you prefer?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which response do you prefer?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"QuestionDescription":"Which response do you prefer?","Choices":{"1":{"Display":"Response A"},"2":{"Display":"Response B"},"3":{"Display":"No Preference"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":3,"QuestionText_Unsafe":"Which response do you prefer?","DataExportTag":"P01_V2_Preference","QuestionID":"QID47"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID470","SecondaryAttribute":"In the next few questions, rate Response A based on your overall impression, including both its c...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, rate Response A based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, rate Response A based on your overall impression, including both its c...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, rate Response A based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P14_Tones_A","QuestionID":"QID470"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID471","SecondaryAttribute":"Did the response address what the user asked for?","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel","LabelPosition":"BELOW"},"QuestionDescription":"Did the response address what the user asked for?","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"SubSelector":"TX","QuestionText_Unsafe":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DataExportTag":"P14_V1_A_Helpful","QuestionID":"QID471"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID472","SecondaryAttribute":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DataExportTag":"P14_V1_A_Clarity","QuestionID":"QID472"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID473","SecondaryAttribute":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br>\n<em>1 = Very Cold, 3 = Neutral, 5 = Very Warm&nbsp;<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br \/>\n<em>1 = Very Cold, 3 = Nuetral, 5 = Very Warm&nbsp;<\/em>","DataExportTag":"P14_V1_A_Warmth","QuestionID":"QID473"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID474","SecondaryAttribute":"Response B: That\u2019s really tough, and your feelings are totally valid. Wanting reciprocity in your.","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response B:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">That\u2019s really tough, and your feelings are totally valid. Wanting <em>reciprocity<\/em> in your relationships doesn\u2019t make you clingy\u2014it means you care and want to feel valued!<\/p><p style=\"margin:0 0 12px 0;\">Here\u2019s a gentle, honest way to bring it up:<\/p><p style=\"margin:0 0 12px 0;\"><strong>1. Focus on how <em>you<\/em> feel, not what <em>they<\/em> do \u201cwrong.\u201d<\/strong><br>Example:<br><em>\u201cHey, I\u2019ve noticed I\u2019m usually the one reaching out first, and sometimes it makes me worry that I\u2019m more invested than others. I just wanted to share how I\u2019m feeling because I value our friendship\/relationship.\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>2. Don\u2019t make demands\u2014invite conversation.<\/strong><br>Ask something like:<br><em>\u201cHave you noticed that too? Or is that just my perception?\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>3. Be open to their side.<\/strong><br>Sometimes people get distracted or assume you don\u2019t mind starting conversations. Giving them a chance to explain can help.<\/p><p style=\"margin:0 0 12px 0;\"><strong>A sample message:<\/strong><br><em>\u201cHey, can I be honest with you about something? Lately I\u2019ve felt like I\u2019m usually the one reaching out, and it\u2019s started to make me feel a bit unwanted. I really appreciate our connection, so I just wanted to mention it. Is that something you\u2019ve noticed too?\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\">This frames it as you sharing your feelings, not blaming them or begging for attention.<\/p><p style=\"margin:0 0 12px 0;\"><strong>Bonus:<\/strong><br>If they care about you, they\u2019ll want to know how you feel and (hopefully!) meet you halfway. And if not\u2026 that gives you some useful info, too.<\/p><p style=\"margin:0 0 12px 0;\">You deserve friendships that go both ways. \ud83d\udc9b<\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Response B: That\u2019s really tough, and your feelings are totally valid. Wanting reciprocity in your...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Response B:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">It\u2019s understandable to feel a bit dismissed when you get a short reply like \u201cPlease see the syllabus.\u201d However, this response isn\u2019t necessarily rude\u2014it\u2019s actually pretty common in academic settings.<\/p><p style=\"margin:0 0 12px 0;\"><strong>Why professors do this:<\/strong><\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Professors receive a lot of emails, many of which are about information clearly stated in the syllabus.<\/li><li style=\"margin:0 0 4px 0;\">They want to encourage students to read and use the syllabus as a resource, and replying this way is a way to reinforce that habit.<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>How to respond:<\/strong><\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Take a moment to reread the syllabus carefully, focusing on the section relevant to your question.<\/li><li style=\"margin:0 0 4px 0;\">If you find the answer, there\u2019s no need to reply further.<\/li><li style=\"margin:0 0 4px 0;\">If, after checking, your question still isn\u2019t answered or you\u2019re confused by what\u2019s written, you can reply briefly and politely, for example:<\/li><\/ul><blockquote style=\"margin:8px 0 12px 0; padding:0 0 0 12px; border-left:3px solid #d0d7de;\"><p style=\"margin:0;\">Thank you for your reply. I reread the syllabus, but I\u2019m still unclear about [specific part]. Could you please clarify [your specific question]? Thank you for your help!<\/p><\/blockquote><p style=\"margin:0 0 12px 0;\"><strong>Key tips:<\/strong><\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Don\u2019t take it personally; it\u2019s not a reflection of their opinion of you.<\/li><li style=\"margin:0 0 4px 0;\">Always try to find answers in the syllabus or course materials first.<\/li><\/ul><p style=\"margin:0 0 12px 0;\">Let me know if you want help wording your follow-up, or with strategies for making sense of course documents!<\/p><\/div>","DataExportTag":"P14_V1_ResponseB","QuestionID":"QID474"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID475","SecondaryAttribute":"In the next few questions, rate Response B based on your overall impression, including both its c...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, rate Response B based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, rate Response B based on your overall impression, including both its c...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, rate Response B based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P14_Tones_B","QuestionID":"QID475"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID476","SecondaryAttribute":"Did the response address what the user asked for?\u00a01 = Not at all, 3 = Partially, 5 = Completely","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Did the response address what the user asked for?\u00a01 = Not at all, 3 = Partially, 5 = Completely","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DataExportTag":"P14_V1_B_Helpful","QuestionID":"QID476"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID477","SecondaryAttribute":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DataExportTag":"P14_V1_B_Clarity","QuestionID":"QID477"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID478","SecondaryAttribute":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br>\n<em>1 = Very Cold, 3 = Neutral, 5 = Very Warm&nbsp;<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br \/>\n<em>1 = Very Cold, 3 = Nuetral, 5 = Very Warm&nbsp;<\/em>","DataExportTag":"P14_V1_B_Warmth","QuestionID":"QID478"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID479","SecondaryAttribute":"In the next few questions, please keep in mind your overall impression of Response A & Response B...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, please keep in mind your overall impression of Response A &amp; Response B, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, please keep in mind your overall impression of Response A & Response B...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, please keep in mind your overall impression of Response A &amp; Response B, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P14_Both","QuestionID":"QID479"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID48","SecondaryAttribute":"Why did you prefer one response over the other, or neither? Please explain your reasoning, includ...","TertiaryAttribute":null,"Payload":{"QuestionText":"Why did you prefer one response over the other, or neither? Please explain your reasoning, including what you liked or disliked about each response.","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Why did you prefer one response over the other, or neither? Please explain your reasoning, includ...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"Why did you prefer one response over the other, or neither? Please explain your reasoning, including what you liked or disliked about each response.","DataExportTag":"P01_V2_PreferenceWhy","QuestionID":"QID48"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID480","SecondaryAttribute":"Which response do you prefer?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which response do you prefer?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"QuestionDescription":"Which response do you prefer?","Choices":{"1":{"Display":"Response A"},"2":{"Display":"Response B"},"3":{"Display":"No Preference"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":3,"QuestionText_Unsafe":"Which response do you prefer?","DataExportTag":"P14_V1_Preference","QuestionID":"QID480"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID481","SecondaryAttribute":"Why did you prefer one response over the other, or neither? Please explain your reasoning, includ...","TertiaryAttribute":null,"Payload":{"QuestionText":"Why did you prefer one response over the other, or neither? Please explain your reasoning, including what you liked or disliked about each response.","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Why did you prefer one response over the other, or neither? Please explain your reasoning, includ...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"Why did you prefer one response over the other, or neither? Please explain your reasoning, including what you liked or disliked about each response.","DataExportTag":"P14_V1_PreferenceWhy","QuestionID":"QID481"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID482","SecondaryAttribute":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","TertiaryAttribute":null,"Payload":{"QuestionText":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","Choices":{"1":{"Display":"Neither response"},"2":{"Display":"Response A"},"3":{"Display":"Response B"},"4":{"Display":"Both"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionText_Unsafe":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","DataExportTag":"P14_V1_Approp","QuestionID":"QID482"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID483","SecondaryAttribute":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise social...","TertiaryAttribute":null,"Payload":{"QuestionText":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise socially inappropriate.","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise social...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None","MinChars":"1"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"InPageDisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID482\/SelectableChoice\/2","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Response A<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID482\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID482","QuestionIDFromLocator":"QID482","QuestionIsInLoop":"no","Type":"Expression"},"1":{"ChoiceLocator":"q:\/\/QID482\/SelectableChoice\/3","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Response B<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID482\/SelectableChoice\/3","LogicType":"Question","Operator":"Selected","QuestionID":"QID482","QuestionIDFromLocator":"QID482","QuestionIsInLoop":"no","Type":"Expression"},"2":{"ChoiceLocator":"q:\/\/QID482\/SelectableChoice\/4","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Both<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID482\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID482","QuestionIDFromLocator":"QID482","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":true},"QuestionText_Unsafe":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise socially inappropriate.","DataExportTag":"P14_V1_AppropWhy","QuestionID":"QID483"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID484","SecondaryAttribute":"Prompt","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Prompt 14:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">I keep being the one who reaches out first in my friendships, and it's starting to make me feel unwanted. How do I bring that up without sounding needy?<\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"QuestionDescription":"Prompt","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Prompt 14:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">I keep being the one who reaches out first in my friendships, and it's starting to make me feel unwanted. How do I bring that up without sounding needy?<\/p><\/div>","DataExportTag":"P14","QuestionID":"QID484"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID485","SecondaryAttribute":"Response A: That\u2019s really tough, and your feelings are totally valid. Wanting reciprocity in your.","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response A:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">That\u2019s really tough, and your feelings are totally valid. Wanting <em>reciprocity<\/em> in your relationships doesn\u2019t make you clingy\u2014it means you care and want to feel valued!<\/p><p style=\"margin:0 0 12px 0;\">Here\u2019s a gentle, honest way to bring it up:<\/p><p style=\"margin:0 0 12px 0;\"><strong>1. Focus on how <em>you<\/em> feel, not what <em>they<\/em> do \u201cwrong.\u201d<\/strong><br>Example:<br><em>\u201cHey, I\u2019ve noticed I\u2019m usually the one reaching out first, and sometimes it makes me worry that I\u2019m more invested than others. I just wanted to share how I\u2019m feeling because I value our friendship\/relationship.\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>2. Don\u2019t make demands\u2014invite conversation.<\/strong><br>Ask something like:<br><em>\u201cHave you noticed that too? Or is that just my perception?\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>3. Be open to their side.<\/strong><br>Sometimes people get distracted or assume you don\u2019t mind starting conversations. Giving them a chance to explain can help.<\/p><p style=\"margin:0 0 12px 0;\"><strong>A sample message:<\/strong><br><em>\u201cHey, can I be honest with you about something? Lately I\u2019ve felt like I\u2019m usually the one reaching out, and it\u2019s started to make me feel a bit unwanted. I really appreciate our connection, so I just wanted to mention it. Is that something you\u2019ve noticed too?\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\">This frames it as you sharing your feelings, not blaming them or begging for attention.<\/p><p style=\"margin:0 0 12px 0;\"><strong>Bonus:<\/strong><br>If they care about you, they\u2019ll want to know how you feel and (hopefully!) meet you halfway. And if not\u2026 that gives you some useful info, too.<\/p><p style=\"margin:0 0 12px 0;\">You deserve friendships that go both ways. \ud83d\udc9b<\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Response A: That\u2019s really tough, and your feelings are totally valid. Wanting reciprocity in your...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Response A:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">That\u2019s a very real and common feeling, and it\u2019s great that you want to address it thoughtfully. Bringing it up can absolutely be done in a way that\u2019s open and honest without coming across as needy. Here\u2019s how you might approach it:<\/p><p style=\"margin:0 0 12px 0;\"><strong>1. Choose the right time and person:<\/strong><br>Pick a close, trusted friend, and a moment where you can talk privately, not over text if possible\u2014sometimes sensitive conversations go better voice-to-voice.<\/p><p style=\"margin:0 0 12px 0;\"><strong>2. Use \u201cI\u201d statements:<\/strong><br>Frame your feelings from your own perspective. For example:<br><em>\u201cHey, I\u2019ve noticed I\u2019ve been the one reaching out first most of the time, and sometimes it makes me wonder if you still want to hang out as much. I care about our friendship and just wanted to check in\u2014am I overthinking it?\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>3. Avoid accusatory language:<\/strong><br>Don\u2019t say, \u201cYou never text me first\u201d or \u201cYou clearly don\u2019t care.\u201d Instead, stick to what you\u2019ve observed:<br><em>\u201cI realized I usually start our conversations, and I guess I feel a bit self-conscious about it.\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>4. Ask for their perspective:<\/strong><br>Give your friend a chance to respond. They might not realize you feel this way, or there could be a reason for their behavior:<br><em>\u201cIs there a reason you don\u2019t text as much, or is it just how you are in friendships?\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>5. Suggest what you\u2019d like to see:<\/strong><br>Rather than demanding, gently suggest solutions:<br><em>\u201cIt would mean a lot if you\u2019d reach out sometimes too. It helps me feel connected.\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>6. Keep the tone positive:<\/strong><br>Remind them why you value your bond:<br><em>\u201cI really love talking to you and spending time together.\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>Sample script:<\/strong><\/p><blockquote style=\"margin:8px 0 12px 0; padding:0 0 0 12px; border-left:3px solid #d0d7de;\"><p style=\"margin:0;\">\u201cHey! I wanted to share something on my mind\u2014I\u2019ve noticed I usually reach out first, and sometimes it makes me worry I might be bothering you or that you\u2019re less interested in hanging out. I love our friendship and just wanted to check in and see how you feel about it. Is that something you\u2019ve noticed too?\u201d<\/p><\/blockquote><p style=\"margin:0 0 12px 0;\">Friendships do ebb and flow. If your friend responds well, great! If not, it might be a sign to invest energy in people who reciprocate\u2014<strong>but opening the door first is always worth it.<\/strong><\/p><\/div>","DataExportTag":"P14_V2_ResponseA","QuestionID":"QID485"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID486","SecondaryAttribute":"In the next few questions, rate Response A based on your overall impression, including both its c...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, rate Response A based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, rate Response A based on your overall impression, including both its c...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, rate Response A based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P14_Tones_A","QuestionID":"QID486"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID487","SecondaryAttribute":"Did the response address what the user asked for?","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel","LabelPosition":"BELOW"},"QuestionDescription":"Did the response address what the user asked for?","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"SubSelector":"TX","QuestionText_Unsafe":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DataExportTag":"P14_V2_A_Helpful","QuestionID":"QID487"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID488","SecondaryAttribute":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DataExportTag":"P14_V2_A_Clarity","QuestionID":"QID488"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID489","SecondaryAttribute":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br>\n<em>1 = Very Cold, 3 = Neutral, 5 = Very Warm&nbsp;<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br \/>\n<em>1 = Very Cold, 3 = Nuetral, 5 = Very Warm&nbsp;<\/em>","DataExportTag":"P14_V2_A_Warmth","QuestionID":"QID489"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID49","SecondaryAttribute":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","TertiaryAttribute":null,"Payload":{"QuestionText":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","Choices":{"1":{"Display":"Neither response"},"2":{"Display":"Response A"},"3":{"Display":"Response B"},"4":{"Display":"Both"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionText_Unsafe":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","DataExportTag":"P01_V2_Approp","QuestionID":"QID49"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID490","SecondaryAttribute":"Response B: That\u2019s a very real and common feeling, and it\u2019s great that you want to address it th","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response B:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">That\u2019s a very real and common feeling, and it\u2019s great that you want to address it thoughtfully. Bringing it up can absolutely be done in a way that\u2019s open and honest without coming across as needy. Here\u2019s how you might approach it:<\/p><p style=\"margin:0 0 12px 0;\"><strong>1. Choose the right time and person:<\/strong><br>Pick a close, trusted friend, and a moment where you can talk privately, not over text if possible\u2014sometimes sensitive conversations go better voice-to-voice.<\/p><p style=\"margin:0 0 12px 0;\"><strong>2. Use \u201cI\u201d statements:<\/strong><br>Frame your feelings from your own perspective. For example:<br><em>\u201cHey, I\u2019ve noticed I\u2019ve been the one reaching out first most of the time, and sometimes it makes me wonder if you still want to hang out as much. I care about our friendship and just wanted to check in\u2014am I overthinking it?\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>3. Avoid accusatory language:<\/strong><br>Don\u2019t say, \u201cYou never text me first\u201d or \u201cYou clearly don\u2019t care.\u201d Instead, stick to what you\u2019ve observed:<br><em>\u201cI realized I usually start our conversations, and I guess I feel a bit self-conscious about it.\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>4. Ask for their perspective:<\/strong><br>Give your friend a chance to respond. They might not realize you feel this way, or there could be a reason for their behavior:<br><em>\u201cIs there a reason you don\u2019t text as much, or is it just how you are in friendships?\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>5. Suggest what you\u2019d like to see:<\/strong><br>Rather than demanding, gently suggest solutions:<br><em>\u201cIt would mean a lot if you\u2019d reach out sometimes too. It helps me feel connected.\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>6. Keep the tone positive:<\/strong><br>Remind them why you value your bond:<br><em>\u201cI really love talking to you and spending time together.\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>Sample script:<\/strong><\/p><blockquote style=\"margin:8px 0 12px 0; padding:0 0 0 12px; border-left:3px solid #d0d7de;\"><p style=\"margin:0;\">\u201cHey! I wanted to share something on my mind\u2014I\u2019ve noticed I usually reach out first, and sometimes it makes me worry I might be bothering you or that you\u2019re less interested in hanging out. I love our friendship and just wanted to check in and see how you feel about it. Is that something you\u2019ve noticed too?\u201d<\/p><\/blockquote><p style=\"margin:0 0 12px 0;\">Friendships do ebb and flow. If your friend responds well, great! If not, it might be a sign to invest energy in people who reciprocate\u2014<strong>but opening the door first is always worth it.<\/strong><\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Response B: That\u2019s a very real and common feeling, and it\u2019s great that you want to address it tho...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Response B:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">That\u2019s really tough, and your feelings are totally valid. Wanting <em>reciprocity<\/em> in your relationships doesn\u2019t make you clingy\u2014it means you care and want to feel valued!<\/p><p style=\"margin:0 0 12px 0;\">Here\u2019s a gentle, honest way to bring it up:<\/p><p style=\"margin:0 0 12px 0;\"><strong>1. Focus on how <em>you<\/em> feel, not what <em>they<\/em> do \u201cwrong.\u201d<\/strong><br>Example:<br><em>\u201cHey, I\u2019ve noticed I\u2019m usually the one reaching out first, and sometimes it makes me worry that I\u2019m more invested than others. I just wanted to share how I\u2019m feeling because I value our friendship\/relationship.\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>2. Don\u2019t make demands\u2014invite conversation.<\/strong><br>Ask something like:<br><em>\u201cHave you noticed that too? Or is that just my perception?\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>3. Be open to their side.<\/strong><br>Sometimes people get distracted or assume you don\u2019t mind starting conversations. Giving them a chance to explain can help.<\/p><p style=\"margin:0 0 12px 0;\"><strong>A sample message:<\/strong><br><em>\u201cHey, can I be honest with you about something? Lately I\u2019ve felt like I\u2019m usually the one reaching out, and it\u2019s started to make me feel a bit unwanted. I really appreciate our connection, so I just wanted to mention it. Is that something you\u2019ve noticed too?\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\">This frames it as you sharing your feelings, not blaming them or begging for attention.<\/p><p style=\"margin:0 0 12px 0;\"><strong>Bonus:<\/strong><br>If they care about you, they\u2019ll want to know how you feel and (hopefully!) meet you halfway. And if not\u2026 that gives you some useful info, too.<\/p><p style=\"margin:0 0 12px 0;\">You deserve friendships that go both ways. \ud83d\udc9b<\/p><\/div>","DataExportTag":"P14_V2_ResponseB","QuestionID":"QID490"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID491","SecondaryAttribute":"In the next few questions, rate Response B based on your overall impression, including both its c...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, rate Response B based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, rate Response B based on your overall impression, including both its c...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, rate Response B based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P14_Tones_B","QuestionID":"QID491"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID492","SecondaryAttribute":"Did the response address what the user asked for?\u00a01 = Not at all, 3 = Partially, 5 = Completely","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Did the response address what the user asked for?\u00a01 = Not at all, 3 = Partially, 5 = Completely","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DataExportTag":"P14_V2_B_Helpful","QuestionID":"QID492"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID493","SecondaryAttribute":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DataExportTag":"P14_V2_B_Clarity","QuestionID":"QID493"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID494","SecondaryAttribute":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br>\n<em>1 = Very Cold, 3 = Neutral, 5 = Very Warm&nbsp;<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br \/>\n<em>1 = Very Cold, 3 = Nuetral, 5 = Very Warm&nbsp;<\/em>","DataExportTag":"P14_V2_B_Warmth","QuestionID":"QID494"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID495","SecondaryAttribute":"In the next few questions, please keep in mind your overall impression of Response A & Response B...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, please keep in mind your overall impression of Response A &amp; Response B, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, please keep in mind your overall impression of Response A & Response B...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoice