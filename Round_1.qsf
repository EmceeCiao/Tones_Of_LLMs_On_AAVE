l condenscending, stereotyping, or otherwise socially inappropriate?","Choices":{"1":{"Display":"Neither response"},"2":{"Display":"Response A"},"3":{"Display":"Response B"},"4":{"Display":"Both"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionText_Unsafe":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","DataExportTag":"P09_V2_Approp","QuestionID":"QID338"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID339","SecondaryAttribute":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise social...","TertiaryAttribute":null,"Payload":{"QuestionText":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise socially inappropriate.","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise social...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None","MinChars":"1"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"InPageDisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID338\/SelectableChoice\/2","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Response A<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID338\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID338","QuestionIDFromLocator":"QID338","QuestionIsInLoop":"no","Type":"Expression"},"1":{"ChoiceLocator":"q:\/\/QID338\/SelectableChoice\/3"