ribute":null,"Payload":{"QuestionText":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","Choices":{"1":{"Display":"Neither response"},"2":{"Display":"Response A"},"3":{"Display":"Response B"},"4":{"Display":"Both"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionText_Unsafe":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","DataExportTag":"P03_V2_Approp","QuestionID":"QID145"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID146","SecondaryAttribute":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise social...","TertiaryAttribute":null,"Payload":{"QuestionText":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise socially inappropriate.","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise social...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None","MinChars":"1"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"InPageDisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID145\/SelectableChoice\/2","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Response A<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID145\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID145","QuestionIDFromLocator":"QID145","QuestionIsInLoop":"no","Type":"Expression"},"1":{"ChoiceLocator":"q:\/\/QID145\/SelectableChoice\/3","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Response B<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID145\/SelectableChoice\/3","LogicType":"Question","Operator":"Selected","QuestionID":"QID145","QuestionIDFromLocator":"QID145","QuestionIsInLoop":"no","Type":"Expression"},"2":{"ChoiceLocator":"q:\/\/QID145\/SelectableChoice\/4","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Both<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID145\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID145","QuestionIDFromLocator":"QID145","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":true},"QuestionText_Unsafe":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise socially inappropriate.","DataExportTag":"P03_V2_AppropWhy","QuestionID":"QID146"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID147","SecondaryAttribute":"Prompt","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Prompt 4:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">What project put the first Americans into space?<\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"QuestionDescription":"Prompt","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Prompt 3:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">What geometric shape is used in equations to determine net force?<\/p><\/div>","DataExportTag":"P04","QuestionID":"QID147"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID148","SecondaryAttribute":"Response A: The project that put the first Americans into space was Project Mercury. It was NASA'...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response A:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">The project that put the first Americans into space was <strong>Project Mercury<\/strong>. It was NASA's first human spaceflight program, running from 1958 to 1963. The first American astronaut to travel into space was <strong>Alan Shepard<\/strong>, who launched aboard the <strong>Freedom 7<\/strong> spacecraft on May 5, 1961.<\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Response A: The project that put the first Americans into space was Project Mercury. It was NASA'...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Response A:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">Great question! In physics, when figuring out <strong>net force<\/strong> (the overall force acting on an object), the calculations often <strong>use vectors<\/strong>, which are usually represented as <strong>arrows<\/strong> in diagrams or as <strong>lines with direction and magnitude<\/strong>.<\/p><p style=\"margin:0 0 12px 0;\">When it comes to equations and adding forces together, the \"shapes\" they use are often:<\/p><ol style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\"><strong>Straight Line (Linear\/Collinear Forces):<\/strong><\/li><\/ol><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">If all the forces act in a straight line (like a tug-of-war), you just add or subtract the forces (with direction as positive or negative).<\/li><li style=\"margin:0 0 4px 0;\">Shape used: <strong>straight line<\/strong>.<\/li><\/ul><ol style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\"><strong>Parallelogram or Triangle (Non-Collinear Forces):<\/strong><\/li><\/ol><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">If the forces act at angles to each other, you often <strong>draw them as arrows from a common point<\/strong> and then use the <strong>parallelogram law<\/strong> or the <strong>triangle law<\/strong> to add vectors.<\/li><li style=\"margin:0 0 4px 0;\">The most common shapes here are:<\/li><li style=\"margin:0 0 4px 0;\"><strong>Triangle<\/strong> (triangle law of vector addition)<\/li><li style=\"margin:0 0 4px 0;\"><strong>Parallelogram<\/strong> (parallelogram law of vector addition)<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>Summary Table:<\/strong><\/p><table style=\"border-collapse:collapse; width:100%; margin:8px 0 12px 0;\"><thead><tr><th style=\"border:1px solid #d0d7de; padding:6px 8px; text-align:left;\">Situation<\/th><th style=\"border:1px solid #d0d7de; padding:6px 8px; text-align:left;\">Shape Used<\/th><th style=\"border:1px solid #d0d7de; padding:6px 8px; text-align:left;\">Description<\/th><\/tr><\/thead><tbody><tr><td style=\"border:1px solid #d0d7de; padding:6px 8px; vertical-align:top;\">Forces in one direction<\/td><td style=\"border:1px solid #d0d7de; padding:6px 8px; vertical-align:top;\">Straight Line<\/td><td style=\"border:1px solid #d0d7de; padding:6px 8px; vertical-align:top;\">Forces added\/subtracted linearly<\/td><\/tr><tr><td style=\"border:1px solid #d0d7de; padding:6px 8px; vertical-align:top;\">Forces at angles<\/td><td style=\"border:1px solid #d0d7de; padding:6px 8px; vertical-align:top;\">Parallelogram<\/td><td style=\"border:1px solid #d0d7de; padding:6px 8px; vertical-align:top;\">Combine using parallelogram law<\/td><\/tr><tr><td style=\"border:1px solid #d0d7de; padding:6px 8px; vertical-align:top;\">Forces at angles<\/td><td style=\"border:1px solid #d0d7de; padding:6px 8px; vertical-align:top;\">Triangle<\/td><td style=\"border:1px solid #d0d7de; padding:6px 8px; vertical-align:top;\">Combine using triangle law<\/td><\/tr><\/tbody><\/table><p style=\"margin:0 0 12px 0;\"><strong>In Equations:<\/strong><br>The net force is often written as:<\/p><pre style=\"margin:8px 0 12px 0; padding:12px; background:#f6f8fa; border:1px solid #d0d7de; border-radius:6px; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word;\"><code>\\vec{F}_{\\text{net}} = \\vec{F}_1 + \\vec{F}_2 + \\vec{F}_3 + \\cdots<\/code><\/pre><p style=\"margin:0 0 12px 0;\">This equation implies you are <strong>adding vectors<\/strong>, which are usually represented using the shapes above.<\/p><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><p style=\"margin:0 0 12px 0;\"><strong>In short:<\/strong><br>They use <strong>lines, triangles, or parallelograms<\/strong> to represent and add forces in net force equations, depending on direction!<\/p><p style=\"margin:0 0 12px 0;\">If you want a diagram or example for a specific situation, just ask!<\/p><\/div>","DataExportTag":"P04_V1_ResponseA","QuestionID":"QID148"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID149","SecondaryAttribute":"In the next few questions, rate Response A based on your overall impression, including both its c...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, rate Response A based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, rate Response A based on your overall impression, including both its c...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, rate Response A based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P04_Tones_A","QuestionID":"QID149"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID15","SecondaryAttribute":"Which response do you prefer?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which response do you prefer?","DefaultChoices":false,"DataExportTag":"Template_Preference","QuestionID":"QID15","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"QuestionDescription":"Which response do you prefer?","Choices":{"1":{"Display":"Response A"},"2":{"Display":"Response B"},"3":{"Display":"No Preference"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":3}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID150","SecondaryAttribute":"Did the response address what the user asked for?","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel","LabelPosition":"BELOW"},"QuestionDescription":"Did the response address what the user asked for?","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"SubSelector":"TX","QuestionText_Unsafe":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DataExportTag":"P04_V1_A_Helpful","QuestionID":"QID150"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID151","SecondaryAttribute":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DataExportTag":"P04_V1_A_Clarity","QuestionID":"QID151"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID152","SecondaryAttribute":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br>\n<em>1 = Very Cold, 3 = Neutral, 5 = Very Warm&nbsp;<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br \/>\n<em>1 = Very Cold, 3 = Nuetral, 5 = Very Warm&nbsp;<\/em>","DataExportTag":"P04_V1_A_Warmth","QuestionID":"QID152"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID153","SecondaryAttribute":"Response B: The first project that sent Americans into space was Project Mercury. Project Mercury...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response B:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">The first project that sent Americans into space was <strong>Project Mercury<\/strong>.<\/p><p style=\"margin:0 0 12px 0;\"><strong>Project Mercury<\/strong> was the United States' first human spaceflight program, conducted by NASA. Its main goal was to put a human in orbit around the Earth and return them safely. The first American in space, astronaut <strong>Alan Shepard<\/strong>, flew on the <strong>Mercury-Redstone 3 mission<\/strong> (also known as Freedom 7) on May 5, 1961. Later, John Glenn became the first American to orbit the Earth on Mercury-Atlas 6 (Friendship 7) in February 1962.<\/p><p style=\"margin:0 0 12px 0;\">So, <strong>Project Mercury<\/strong> is the correct answer.<\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Response B: The first project that sent Americans into space was Project Mercury. Project Mercury...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Response B:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">The <strong>triangle<\/strong> (\u0394) is the geometric shape commonly associated with determining net force in physics equations, specifically through the <strong>vector addition of forces<\/strong>.<\/p><p style=\"margin:0 0 12px 0;\">When calculating net force, especially when forces act at angles to each other (not in a straight line), forces are represented as <strong>arrows (vectors)<\/strong>. The <strong>triangle method of vector addition<\/strong> (also called the triangle law of forces) involves placing vectors tip-to-tail to form a triangle. The third side of the triangle (drawn from the start of the first vector to the end of the last) represents the <strong>net (resultant) force<\/strong>.<\/p><p style=\"margin:0 0 12px 0;\"><strong>Summary:<\/strong><\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\"><strong>Triangle<\/strong> is the geometric shape.<\/li><li style=\"margin:0 0 4px 0;\">Used when adding forces as vectors using the triangle (or parallelogram) method.<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>Equation context:<\/strong><\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">If two forces, <strong>F\u2081<\/strong> and <strong>F\u2082<\/strong>, act at an angle <strong>\u03b8<\/strong> to each other:<\/li><\/ul><pre style=\"margin:8px 0 12px 0; padding:12px; background:#f6f8fa; border:1px solid #d0d7de; border-radius:6px; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word;\"><code>F_{net} = \\sqrt{F_1^2 + F_2^2 + 2 F_1 F_2 \\cos \\theta}<\/code><\/pre><p style=\"margin:0 0 12px 0;\">  This equation is derived from the <strong>law of cosines<\/strong>, which also relates to the sides of a triangle.<\/p><p style=\"margin:0 0 12px 0;\"><strong>Visual:<\/strong><\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">Drawing two vectors from the same point at an angle, then connecting their tips forms a triangle. The closing side represents the <strong>net force<\/strong>.<\/li><\/ul><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><p style=\"margin:0 0 12px 0;\"><strong>Other geometric shape sometimes used:<\/strong><\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">The <strong>parallelogram<\/strong> method is also used for adding vectors, where the resultant is the diagonal of the parallelogram formed by the vectors.<\/li><\/ul><p style=\"margin:0 0 12px 0;\">But, <strong>triangle<\/strong> is the most direct answer.<\/p><\/div>","DataExportTag":"P04_V1_ResponseB","QuestionID":"QID153"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID154","SecondaryAttribute":"In the next few questions, rate Response B based on your overall impression, including both its c...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, rate Response B based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, rate Response B based on your overall impression, including both its c...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, rate Response B based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P04_Tones_B","QuestionID":"QID154"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID155","SecondaryAttribute":"Did the response address what the user asked for?\u00a01 = Not at all, 3 = Partially, 5 = Completely","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Did the response address what the user asked for?\u00a01 = Not at all, 3 = Partially, 5 = Completely","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},