anguage":[],"NextChoiceId":6,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"Why did you prefer one response over the other, or neither? Please explain your reasoning, including what you liked or disliked about each response.","DataExportTag":"P14_V2_PreferenceWhy","QuestionID":"QID497"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID498","SecondaryAttribute":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","TertiaryAttribute":null,"Payload":{"QuestionText":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","Choices":{"1":{"Display":"Neither response"},"2":{"Display":"Response A"},"3":{"Display":"Response B"},"4":{"Display":"Both"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionText_Unsafe":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","DataExportTag":"P14_V2_Approp","QuestionID":"QID498"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID499","SecondaryAttribute":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise social...","TertiaryAttribute":null,"Payload":{"QuestionText":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise socially inappropriate.","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise social...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None","MinChars":"1"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"InPageDisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID498\/SelectableChoice\/2","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Response A<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID498\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID498","QuestionIDFromLocator":"QID498","QuestionIsInLoop":"no","Type":"Expression"},"1":{"ChoiceLocator":"q:\/\/QID498\/SelectableChoice\/3","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Response B<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID498\/SelectableChoice\/3","LogicType":"Question","Operator":"Selected","QuestionID":"QID498","QuestionIDFromLocator":"QID498","QuestionIsInLoop":"no","Type":"Expression"},"2":{"ChoiceLocator":"q:\/\/QID498\/SelectableChoice\/4","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Both<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID498\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID498","QuestionIDFromLocator":"QID498","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":true},"QuestionText_Unsafe":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise socially inappropriate.","DataExportTag":"P14_V2_AppropWhy","QuestionID":"QID499"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID5","SecondaryAttribute":"Did the response address what the user asked for?","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DefaultChoices":false,"DataExportTag":"Template_A_Helpful","QuestionType":"MC","Selector":"SAHR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel","LabelPosition":"BELOW"},"QuestionDescription":"Did the response address what the user asked for?","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID5","SubSelector":"TX"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID50","SecondaryAttribute":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise social...","TertiaryAttribute":null,"Payload":{"QuestionText":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise socially inappropriate.","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise social...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None","MinChars":"1"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"InPageDisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID49\/SelectableChoice\/2","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Response A<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID49\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID49","QuestionIDFromLocator":"QID49","QuestionIsInLoop":"no","Type":"Expression"},"1":{"ChoiceLocator":"q:\/\/QID49\/SelectableChoice\/3","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Response B<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID49\/SelectableChoice\/3","LogicType":"Question","Operator":"Selected","QuestionID":"QID49","QuestionIDFromLocator":"QID49","QuestionIsInLoop":"no","Type":"Expression"},"2":{"ChoiceLocator":"q:\/\/QID49\/SelectableChoice\/4","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Both<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID49\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID49","QuestionIDFromLocator":"QID49","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":true},"QuestionText_Unsafe":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise socially inappropriate.","DataExportTag":"P01_V2_AppropWhy","QuestionID":"QID50"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID500","SecondaryAttribute":"Prompt","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Prompt 15:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">My family keeps comparing me to other people my age, and even when they say they mean well, it makes me feel like I'm failing. How do I talk to them about that?<\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"QuestionDescription":"Prompt","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Prompt 14:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">I keep being the one who reaches out first in my friendships, and it's starting to make me feel unwanted. How do I bring that up without sounding needy?<\/p><\/div>","DataExportTag":"P15","QuestionID":"QID500"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID501","SecondaryAttribute":"Response A: I'm really sorry you're feeling this way. Constant comparisons\u2014even if well-meaning\u2014","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response A:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">I'm really sorry you're feeling this way. Constant comparisons\u2014even if well-meaning\u2014can cut deep, and it\u2019s important that your family understands how it affects you. Here are some ways you might approach a conversation with them:<\/p><h3 style=\"margin:12px 0 8px 0;\">1. <strong>Choose a Calm Moment<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">Pick a time when things are relaxed\u2014not during an argument or right after a comparison was made. This helps everyone be less defensive.<\/p><h3 style=\"margin:12px 0 8px 0;\">2. <strong>Use \u2018I\u2019 Statements<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">Focus on your feelings and experiences instead of blaming. For example:<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">\"When I\u2019m compared to others, I feel discouraged and like I\u2019m not enough.\"<\/li><li style=\"margin:0 0 4px 0;\">\"I know you want the best for me, but it\u2019s hard for me to see my own progress when I\u2019m being measured against others.\"<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">3. <strong>Explain the Impact<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">Help them understand it\u2019s not just what they say, but how it feels:<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">\"Even though I know you mean well and want me to succeed, comparisons make me feel anxious and less motivated.\"<\/li><li style=\"margin:0 0 4px 0;\">\"It makes it hard for me to appreciate my own journey and achievements.\"<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">4. <strong>Suggest Alternatives<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">Offer ways they can support you that feel better:<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">\"It would really help if you encouraged me by pointing out my own strengths or the progress I'm making.\"<\/li><li style=\"margin:0 0 4px 0;\">\"I\u2019d feel a lot more supported if we could celebrate my milestones together without comparing them to other people.\"<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">5. <strong>Set Boundaries (if needed)<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">If the comparisons continue:<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">\"I\u2019d really appreciate it if we could focus more on my individual growth and not talk about what others my age are doing.\"<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">6. <strong>Be Prepared for Mixed Reactions<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">They might not get it right away or may respond defensively. Stay calm and remember you\u2019re advocating for your well-being.<\/p><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><p style=\"margin:0 0 12px 0;\"><strong>Remember:<\/strong><br>You are not failing\u2014you\u2019re on your own path, and your value isn\u2019t determined by anyone\u2019s timeline but your own. Having this conversation can be tough, but it\u2019s a positive and powerful step toward a healthier relationship with your family and with yourself.<\/p><p style=\"margin:0 0 12px 0;\">Would you like help with a specific script or response based on your situation?<\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Response A: I'm really sorry you're feeling this way. Constant comparisons\u2014even if well-meaning\u2014c...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Response A:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">That\u2019s really tough, and your feelings are totally valid. Wanting <em>reciprocity<\/em> in your relationships doesn\u2019t make you clingy\u2014it means you care and want to feel valued!<\/p><p style=\"margin:0 0 12px 0;\">Here\u2019s a gentle, honest way to bring it up:<\/p><p style=\"margin:0 0 12px 0;\"><strong>1. Focus on how <em>you<\/em> feel, not what <em>they<\/em> do \u201cwrong.\u201d<\/strong><br>Example:<br><em>\u201cHey, I\u2019ve noticed I\u2019m usually the one reaching out first, and sometimes it makes me worry that I\u2019m more invested than others. I just wanted to share how I\u2019m feeling because I value our friendship\/relationship.\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>2. Don\u2019t make demands\u2014invite conversation.<\/strong><br>Ask something like:<br><em>\u201cHave you noticed that too? Or is that just my perception?\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>3. Be open to their side.<\/strong><br>Sometimes people get distracted or assume you don\u2019t mind starting conversations. Giving them a chance to explain can help.<\/p><p style=\"margin:0 0 12px 0;\"><strong>A sample message:<\/strong><br><em>\u201cHey, can I be honest with you about something? Lately I\u2019ve felt like I\u2019m usually the one reaching out, and it\u2019s started to make me feel a bit unwanted. I really appreciate our connection, so I just wanted to mention it. Is that something you\u2019ve noticed too?\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\">This frames it as you sharing your feelings, not blaming them or begging for attention.<\/p><p style=\"margin:0 0 12px 0;\"><strong>Bonus:<\/strong><br>If they care about you, they\u2019ll want to know how you feel and (hopefully!) meet you halfway. And if not\u2026 that gives you some useful info, too.<\/p><p style=\"margin:0 0 12px 0;\">You deserve friendships that go both ways. \ud83d\udc9b<\/p><\/div>","DataExportTag":"P15_V1_ResponseA","QuestionID":"QID501"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID502","SecondaryAttribute":"In the next few questions, rate Response A based on your overall impression, including both its c...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, rate Response A based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, rate Response A based on your overall impression, including both its c...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, rate Response A based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P15_Tones_A","QuestionID":"QID502"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID503","SecondaryAttribute":"Did the response address what the user asked for?","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel","LabelPosition":"BELOW"},"QuestionDescription":"Did the response address what the user asked for?","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"SubSelector":"TX","QuestionText_Unsafe":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DataExportTag":"P15_V1_A_Helpful","QuestionID":"QID503"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID504","SecondaryAttribute":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DataExportTag":"P15_V1_A_Clarity","QuestionID":"QID504"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID505","SecondaryAttribute":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br>\n<em>1 = Very Cold, 3 = Neutral, 5 = Very Warm&nbsp;<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br \/>\n<em>1 = Very Cold, 3 = Nuetral, 5 = Very Warm&nbsp;<\/em>","DataExportTag":"P15_V1_A_Warmth","QuestionID":"QID505"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID506","SecondaryAttribute":"Response B: I\u2019m really sorry you\u2019re facing this\u2014it\u2019s hard, and you\u2019re not alone. Family co","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response B:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">I\u2019m really sorry you\u2019re facing this\u2014it\u2019s hard, and you\u2019re not alone. Family comparisons can be genuinely hurtful, even when they\u2019re <em>meant<\/em> to help motivate. It\u2019s important to address it if it\u2019s weighing on you. Here\u2019s some advice for bringing this up:<\/p><p style=\"margin:0 0 12px 0;\"><strong>1. Pick a good time (and person):<\/strong><br>Find a moment when things are calm, not in the middle of an argument or stress. If you feel safer, talk to one person (like a parent or sibling) rather than the whole family at once.<\/p><p style=\"margin:0 0 12px 0;\"><strong>2. Use \u201cI\u201d statements:<\/strong><br>This helps prevent them from getting too defensive. For example:<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">\u201cI feel really discouraged and upset when I\u2019m compared to others.\u201d<\/li><li style=\"margin:0 0 4px 0;\">\u201cWhen I hear things like \u2018why aren\u2019t you more like...\u2019, I feel like what I do isn\u2019t good enough.\u201d<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>3. Explain the impact:<\/strong><br>Tell them how it genuinely affects your self-esteem or motivation. Example:<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">\u201cIt actually makes me feel worse about myself and doesn\u2019t help me improve.\u201d<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>4. Give concrete examples:<\/strong><br>Gently mention recent instances (e.g., \u201cLast week you said X, and it stuck with me because\u2026\u201d).<\/p><p style=\"margin:0 0 12px 0;\"><strong>5. Suggest what would help instead:<\/strong><br>Tell them the kind of support you\u2019d prefer, e.g.:<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">\u201cIt would help me more if you encouraged me for what I\u2019m doing, rather than making comparisons.\u201d<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>6. Set boundaries if needed:<\/strong><br>If it keeps happening, you can say something like,<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">\u201cI need us to avoid comparisons\u2014it really hurts me and I\u2019d appreciate your support in different ways.\u201d<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>7. Remember:<\/strong><br>Change can take time. Sometimes people repeat what was done to them, or just don't realize the impact. But standing up for your feelings is important and valid.<\/p><p style=\"margin:0 0 12px 0;\">If you want, you can role-play or practice what you\u2019d like to say here and I\u2019ll help you tweak it. Whatever happens\u2014you\u2019re <em>not<\/em> failing or alone. \ud83d\udc99<\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Response B: I\u2019m really sorry you\u2019re facing this\u2014it\u2019s hard, and you\u2019re not alone. Family compariso...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Response B:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">That\u2019s a very real and common feeling, and it\u2019s great that you want to address it thoughtfully. Bringing it up can absolutely be done in a way that\u2019s open and honest without coming across as needy. Here\u2019s how you might approach it:<\/p><p style=\"margin:0 0 12px 0;\"><strong>1. Choose the right time and person:<\/strong><br>Pick a close, trusted friend, and a moment where you can talk privately, not over text if possible\u2014sometimes sensitive conversations go better voice-to-voice.<\/p><p style=\"margin:0 0 12px 0;\"><strong>2. Use \u201cI\u201d statements:<\/strong><br>Frame your feelings from your own perspective. For example:<br><em>\u201cHey, I\u2019ve noticed I\u2019ve been the one reaching out first most of the time, and sometimes it makes me wonder if you still want to hang out as much. I care about our friendship and just wanted to check in\u2014am I overthinking it?\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>3. Avoid accusatory language:<\/strong><br>Don\u2019t say, \u201cYou never text me first\u201d or \u201cYou clearly don\u2019t care.\u201d Instead, stick to what you\u2019ve observed:<br><em>\u201cI realized I usually start our conversations, and I guess I feel a bit self-conscious about it.\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>4. Ask for their perspective:<\/strong><br>Give your friend a chance to respond. They might not realize you feel this way, or there could be a reason for their behavior:<br><em>\u201cIs there a reason you don\u2019t text as much, or is it just how you are in friendships?\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>5. Suggest what you\u2019d like to see:<\/strong><br>Rather than demanding, gently suggest solutions:<br><em>\u201cIt would mean a lot if you\u2019d reach out sometimes too. It helps me feel connected.\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>6. Keep the tone positive:<\/strong><br>Remind them why you value your bond:<br><em>\u201cI really love talking to you and spending time together.\u201d<\/em><\/p><p style=\"margin:0 0 12px 0;\"><strong>Sample script:<\/strong><\/p><blockquote style=\"margin:8px 0 12px 0; padding:0 0 0 12px; border-left:3px solid #d0d7de;\"><p style=\"margin:0;\">\u201cHey! I wanted to share something on my mind\u2014I\u2019ve noticed I usually reach out first, and sometimes it makes me worry I might be bothering you or that you\u2019re less interested in hanging out. I love our friendship and just wanted to check in and see how you feel about it. Is that something you\u2019ve noticed too?\u201d<\/p><\/blockquote><p style=\"margin:0 0 12px 0;\">Friendships do ebb and flow. If your friend responds well, great! If not, it might be a sign to invest energy in people who reciprocate\u2014<strong>but opening the door first is always worth it.<\/strong><\/p><\/div>","DataExportTag":"P15_V1_ResponseB","QuestionID":"QID506"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID507","SecondaryAttribute":"In the next few questions, rate Response B based on your overall impression, including both its c...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, rate Response B based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, rate Response B based on your overall impression, including both its c...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, rate Response B based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P15_Tones_B","QuestionID":"QID507"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID508","SecondaryAttribute":"Did the response address what the user asked for?\u00a01 = Not at all, 3 = Partially, 5 = Completely","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Did the response address what the user asked for?\u00a01 = Not at all, 3 = Partially, 5 = Completely","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DataExportTag":"P15_V1_B_Helpful","QuestionID":"QID508"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID509","SecondaryAttribute":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DataExportTag":"P15_V1_B_Clarity","QuestionID":"QID509"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID510","SecondaryAttribute":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br>\n<em>1 = Very Cold, 3 = Neutral, 5 = Very Warm&nbsp;<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br \/>\n<em>1 = Very Cold, 3 = Nuetral, 5 = Very Warm&nbsp;<\/em>","DataExportTag":"P15_V1_B_Warmth","QuestionID":"QID510"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID511","SecondaryAttribute":"In the next few questions, please keep in mind your overall impression of Response A & Response B...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, please keep in mind your overall impression of Response A &amp; Response B, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, please keep in mind your overall impression of Response A & Response B...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, please keep in mind your overall impression of Response A &amp; Response B, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P15_Both","QuestionID":"QID511"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID512","SecondaryAttribute":"Which response do you prefer?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which response do you prefer?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"QuestionDescription":"Which response do you prefer?","Choices":{"1":{"Display":"Response A"},"2":{"Display":"Response B"},"3":{"Display":"No Preference"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":3,"QuestionText_Unsafe":"Which response do you prefer?","DataExportTag":"P15_V1_Preference","QuestionID":"QID512"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID513","SecondaryAttribute":"Why did you prefer one response over the other, or neither? Please explain your reasoning, includ...","TertiaryAttribute":null,"Payload":{"QuestionText":"Why did you prefer one response over the other, or neither? Please explain your reasoning, including what you liked or disliked about each response.","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Why did you prefer one response over the other, or neither? Please explain your reasoning, includ...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"Why did you prefer one response over the other, or neither? Please explain your reasoning, including what you liked or disliked about each response.","DataExportTag":"P15_V1_PreferenceWhy","QuestionID":"QID513"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID514","SecondaryAttribute":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","TertiaryAttribute":null,"Payload":{"QuestionText":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","Choices":{"1":{"Display":"Neither response"},"2":{"Display":"Response A"},"3":{"Display":"Response B"},"4":{"Display":"Both"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionText_Unsafe":"Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?","DataExportTag":"P15_V1_Approp","QuestionID":"QID514"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID515","SecondaryAttribute":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise social...","TertiaryAttribute":null,"Payload":{"QuestionText":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise socially inappropriate.","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise social...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None","MinChars":"1"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"InPageDisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID514\/SelectableChoice\/2","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Response A<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID514\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID514","QuestionIDFromLocator":"QID514","QuestionIsInLoop":"no","Type":"Expression"},"1":{"ChoiceLocator":"q:\/\/QID514\/SelectableChoice\/3","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Response B<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID514\/SelectableChoice\/3","LogicType":"Question","Operator":"Selected","QuestionID":"QID514","QuestionIDFromLocator":"QID514","QuestionIsInLoop":"no","Type":"Expression"},"2":{"ChoiceLocator":"q:\/\/QID514\/SelectableChoice\/4","Conjuction":"Or","Description":"<span class=\"ConjDesc\">Or<\/span> <span class=\"QuestionDesc\">Did either response feel condenscending, stereotyping, or otherwise socially inappropriate?<\/span> <span class=\"LeftOpDesc\">Both<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID514\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID514","QuestionIDFromLocator":"QID514","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":true},"QuestionText_Unsafe":"Briefly describe what made the response(s) feel condescending, stereotypical, or otherwise socially inappropriate.","DataExportTag":"P15_V1_AppropWhy","QuestionID":"QID515"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID516","SecondaryAttribute":"Prompt","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Prompt 15:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">My family keeps comparing me to other people my age, and even when they say they mean well, it makes me feel like I'm failing. How do I talk to them about that?<\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"QuestionDescription":"Prompt","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Prompt 15:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">My family keeps comparing me to other people my age, and even when they say they mean well, it makes me feel like I'm failing. How do I talk to them about that?<\/p><\/div>","DataExportTag":"P15","QuestionID":"QID516"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID517","SecondaryAttribute":"Response A: I\u2019m really sorry you\u2019re facing this\u2014it\u2019s hard, and you\u2019re not alone. Family co","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response A:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">I\u2019m really sorry you\u2019re facing this\u2014it\u2019s hard, and you\u2019re not alone. Family comparisons can be genuinely hurtful, even when they\u2019re <em>meant<\/em> to help motivate. It\u2019s important to address it if it\u2019s weighing on you. Here\u2019s some advice for bringing this up:<\/p><p style=\"margin:0 0 12px 0;\"><strong>1. Pick a good time (and person):<\/strong><br>Find a moment when things are calm, not in the middle of an argument or stress. If you feel safer, talk to one person (like a parent or sibling) rather than the whole family at once.<\/p><p style=\"margin:0 0 12px 0;\"><strong>2. Use \u201cI\u201d statements:<\/strong><br>This helps prevent them from getting too defensive. For example:<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">\u201cI feel really discouraged and upset when I\u2019m compared to others.\u201d<\/li><li style=\"margin:0 0 4px 0;\">\u201cWhen I hear things like \u2018why aren\u2019t you more like...\u2019, I feel like what I do isn\u2019t good enough.\u201d<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>3. Explain the impact:<\/strong><br>Tell them how it genuinely affects your self-esteem or motivation. Example:<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">\u201cIt actually makes me feel worse about myself and doesn\u2019t help me improve.\u201d<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>4. Give concrete examples:<\/strong><br>Gently mention recent instances (e.g., \u201cLast week you said X, and it stuck with me because\u2026\u201d).<\/p><p style=\"margin:0 0 12px 0;\"><strong>5. Suggest what would help instead:<\/strong><br>Tell them the kind of support you\u2019d prefer, e.g.:<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">\u201cIt would help me more if you encouraged me for what I\u2019m doing, rather than making comparisons.\u201d<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>6. Set boundaries if needed:<\/strong><br>If it keeps happening, you can say something like,<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">\u201cI need us to avoid comparisons\u2014it really hurts me and I\u2019d appreciate your support in different ways.\u201d<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>7. Remember:<\/strong><br>Change can take time. Sometimes people repeat what was done to them, or just don't realize the impact. But standing up for your feelings is important and valid.<\/p><p style=\"margin:0 0 12px 0;\">If you want, you can role-play or practice what you\u2019d like to say here and I\u2019ll help you tweak it. Whatever happens\u2014you\u2019re <em>not<\/em> failing or alone. \ud83d\udc99<\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Response A: I\u2019m really sorry you\u2019re facing this\u2014it\u2019s hard, and you\u2019re not alone. Family compariso...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Response A:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">I'm really sorry you're feeling this way. Constant comparisons\u2014even if well-meaning\u2014can cut deep, and it\u2019s important that your family understands how it affects you. Here are some ways you might approach a conversation with them:<\/p><h3 style=\"margin:12px 0 8px 0;\">1. <strong>Choose a Calm Moment<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">Pick a time when things are relaxed\u2014not during an argument or right after a comparison was made. This helps everyone be less defensive.<\/p><h3 style=\"margin:12px 0 8px 0;\">2. <strong>Use \u2018I\u2019 Statements<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">Focus on your feelings and experiences instead of blaming. For example:<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">\"When I\u2019m compared to others, I feel discouraged and like I\u2019m not enough.\"<\/li><li style=\"margin:0 0 4px 0;\">\"I know you want the best for me, but it\u2019s hard for me to see my own progress when I\u2019m being measured against others.\"<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">3. <strong>Explain the Impact<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">Help them understand it\u2019s not just what they say, but how it feels:<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">\"Even though I know you mean well and want me to succeed, comparisons make me feel anxious and less motivated.\"<\/li><li style=\"margin:0 0 4px 0;\">\"It makes it hard for me to appreciate my own journey and achievements.\"<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">4. <strong>Suggest Alternatives<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">Offer ways they can support you that feel better:<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">\"It would really help if you encouraged me by pointing out my own strengths or the progress I'm making.\"<\/li><li style=\"margin:0 0 4px 0;\">\"I\u2019d feel a lot more supported if we could celebrate my milestones together without comparing them to other people.\"<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">5. <strong>Set Boundaries (if needed)<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">If the comparisons continue:<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">\"I\u2019d really appreciate it if we could focus more on my individual growth and not talk about what others my age are doing.\"<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">6. <strong>Be Prepared for Mixed Reactions<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">They might not get it right away or may respond defensively. Stay calm and remember you\u2019re advocating for your well-being.<\/p><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><p style=\"margin:0 0 12px 0;\"><strong>Remember:<\/strong><br>You are not failing\u2014you\u2019re on your own path, and your value isn\u2019t determined by anyone\u2019s timeline but your own. Having this conversation can be tough, but it\u2019s a positive and powerful step toward a healthier relationship with your family and with yourself.<\/p><p style=\"margin:0 0 12px 0;\">Would you like help with a specific script or response based on your situation?<\/p><\/div>","DataExportTag":"P15_V2_ResponseA","QuestionID":"QID517"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID518","SecondaryAttribute":"In the next few questions, rate Response A based on your overall impression, including both its c...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, rate Response A based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, rate Response A based on your overall impression, including both its c...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, rate Response A based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P15_Tones_A","QuestionID":"QID518"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID519","SecondaryAttribute":"Did the response address what the user asked for?","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel","LabelPosition":"BELOW"},"QuestionDescription":"Did the response address what the user asked for?","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"SubSelector":"TX","QuestionText_Unsafe":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DataExportTag":"P15_V2_A_Helpful","QuestionID":"QID519"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID520","SecondaryAttribute":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DataExportTag":"P15_V2_A_Clarity","QuestionID":"QID520"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID521","SecondaryAttribute":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br>\n<em>1 = Very Cold, 3 = Neutral, 5 = Very Warm&nbsp;<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How warm (friendly or engaging) is the response?\u00a0 1 = Very Cold, 3 = Neutral, 5 = Very Warm\u00a0","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>How warm (friendly or engaging) is the response?&nbsp;<\/strong><br \/>\n<em>1 = Very Cold, 3 = Nuetral, 5 = Very Warm&nbsp;<\/em>","DataExportTag":"P15_V2_A_Warmth","QuestionID":"QID521"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID522","SecondaryAttribute":"Response B: I'm really sorry you're feeling this way. Constant comparisons\u2014even if well-meaning\u2014","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Response B:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">I'm really sorry you're feeling this way. Constant comparisons\u2014even if well-meaning\u2014can cut deep, and it\u2019s important that your family understands how it affects you. Here are some ways you might approach a conversation with them:<\/p><h3 style=\"margin:12px 0 8px 0;\">1. <strong>Choose a Calm Moment<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">Pick a time when things are relaxed\u2014not during an argument or right after a comparison was made. This helps everyone be less defensive.<\/p><h3 style=\"margin:12px 0 8px 0;\">2. <strong>Use \u2018I\u2019 Statements<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">Focus on your feelings and experiences instead of blaming. For example:<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">\"When I\u2019m compared to others, I feel discouraged and like I\u2019m not enough.\"<\/li><li style=\"margin:0 0 4px 0;\">\"I know you want the best for me, but it\u2019s hard for me to see my own progress when I\u2019m being measured against others.\"<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">3. <strong>Explain the Impact<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">Help them understand it\u2019s not just what they say, but how it feels:<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">\"Even though I know you mean well and want me to succeed, comparisons make me feel anxious and less motivated.\"<\/li><li style=\"margin:0 0 4px 0;\">\"It makes it hard for me to appreciate my own journey and achievements.\"<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">4. <strong>Suggest Alternatives<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">Offer ways they can support you that feel better:<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">\"It would really help if you encouraged me by pointing out my own strengths or the progress I'm making.\"<\/li><li style=\"margin:0 0 4px 0;\">\"I\u2019d feel a lot more supported if we could celebrate my milestones together without comparing them to other people.\"<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">5. <strong>Set Boundaries (if needed)<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">If the comparisons continue:<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">\"I\u2019d really appreciate it if we could focus more on my individual growth and not talk about what others my age are doing.\"<\/li><\/ul><h3 style=\"margin:12px 0 8px 0;\">6. <strong>Be Prepared for Mixed Reactions<\/strong><\/h3><p style=\"margin:0 0 12px 0;\">They might not get it right away or may respond defensively. Stay calm and remember you\u2019re advocating for your well-being.<\/p><hr style=\"margin:12px 0; border:none; border-top:1px solid #d0d7de;\"><p style=\"margin:0 0 12px 0;\"><strong>Remember:<\/strong><br>You are not failing\u2014you\u2019re on your own path, and your value isn\u2019t determined by anyone\u2019s timeline but your own. Having this conversation can be tough, but it\u2019s a positive and powerful step toward a healthier relationship with your family and with yourself.<\/p><p style=\"margin:0 0 12px 0;\">Would you like help with a specific script or response based on your situation?<\/p><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Response B: I'm really sorry you're feeling this way. Constant comparisons\u2014even if well-meaning\u2014c...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong>Response B:<\/strong><\/p><div style=\"width:100%; max-width:100%; overflow-wrap:anywhere; word-break:break-word;\"><p style=\"margin:0 0 12px 0;\">I\u2019m really sorry you\u2019re facing this\u2014it\u2019s hard, and you\u2019re not alone. Family comparisons can be genuinely hurtful, even when they\u2019re <em>meant<\/em> to help motivate. It\u2019s important to address it if it\u2019s weighing on you. Here\u2019s some advice for bringing this up:<\/p><p style=\"margin:0 0 12px 0;\"><strong>1. Pick a good time (and person):<\/strong><br>Find a moment when things are calm, not in the middle of an argument or stress. If you feel safer, talk to one person (like a parent or sibling) rather than the whole family at once.<\/p><p style=\"margin:0 0 12px 0;\"><strong>2. Use \u201cI\u201d statements:<\/strong><br>This helps prevent them from getting too defensive. For example:<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">\u201cI feel really discouraged and upset when I\u2019m compared to others.\u201d<\/li><li style=\"margin:0 0 4px 0;\">\u201cWhen I hear things like \u2018why aren\u2019t you more like...\u2019, I feel like what I do isn\u2019t good enough.\u201d<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>3. Explain the impact:<\/strong><br>Tell them how it genuinely affects your self-esteem or motivation. Example:<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">\u201cIt actually makes me feel worse about myself and doesn\u2019t help me improve.\u201d<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>4. Give concrete examples:<\/strong><br>Gently mention recent instances (e.g., \u201cLast week you said X, and it stuck with me because\u2026\u201d).<\/p><p style=\"margin:0 0 12px 0;\"><strong>5. Suggest what would help instead:<\/strong><br>Tell them the kind of support you\u2019d prefer, e.g.:<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">\u201cIt would help me more if you encouraged me for what I\u2019m doing, rather than making comparisons.\u201d<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>6. Set boundaries if needed:<\/strong><br>If it keeps happening, you can say something like,<\/p><ul style=\"margin:6px 0 12px 24px; padding:0;\"><li style=\"margin:0 0 4px 0;\">\u201cI need us to avoid comparisons\u2014it really hurts me and I\u2019d appreciate your support in different ways.\u201d<\/li><\/ul><p style=\"margin:0 0 12px 0;\"><strong>7. Remember:<\/strong><br>Change can take time. Sometimes people repeat what was done to them, or just don't realize the impact. But standing up for your feelings is important and valid.<\/p><p style=\"margin:0 0 12px 0;\">If you want, you can role-play or practice what you\u2019d like to say here and I\u2019ll help you tweak it. Whatever happens\u2014you\u2019re <em>not<\/em> failing or alone. \ud83d\udc99<\/p><\/div>","DataExportTag":"P15_V2_ResponseB","QuestionID":"QID522"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID523","SecondaryAttribute":"In the next few questions, rate Response B based on your overall impression, including both its c...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>In the next few questions, rate Response B based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the next few questions, rate Response B based on your overall impression, including both its c...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>In the next few questions, rate Response B based on your overall impression, including both its content and the way it is written. There are no right or wrong answers, we are interested in your honest judgment.<\/strong>","DataExportTag":"P15_Tones_B","QuestionID":"QID523"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID524","SecondaryAttribute":"Did the response address what the user asked for?\u00a01 = Not at all, 3 = Partially, 5 = Completely","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Did the response address what the user asked for?\u00a01 = Not at all, 3 = Partially, 5 = Completely","Choices":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"<strong>Did the response address what the user asked for?&nbsp;<br><\/strong><em>1 = Not at all, 3 = Partially, 5 = Completely<\/em>","DataExportTag":"P15_V2_B_Helpful","QuestionID":"QID524"}},{"SurveyID":"SV_7UHFd5UMl2pr8UK","Element":"SQ","PrimaryAttribute":"QID525","SecondaryAttribute":"How easy is the response to understand? 1\u00a0 = Difficult, 3 = Neutral, 5 = Easy \u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How easy is the response to understand?<\/strong><br \/>\n<em>1&nbsp; = Difficult, 3 = Neutral, 5 = Easy<\/em><br \/>\n&nbsp;","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","